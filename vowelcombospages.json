              { "cells": ["oo", "[uː] в большинстве", "moon, food, school"] },
              { "cells": ["oo", "[ʊ] в коротких",    "book, look, foot"] }
            ],
            "borderColor": "info"
          }
        },
        {
          "title": "Ee → [iː]",
          "borderColor": "example",
