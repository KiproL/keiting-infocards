          ]
        },
        {
          "title": "y → [aɪ] в односложных",
          "borderColor": "info",
          "examples": [
            { "en": "My  [maɪ]", "ru": "мой" },
            { "en": "Sky [skaɪ]","ru": "небо" },
            { "en": "Try [traɪ]","ru": "пробовать" },
            { "en": "Fly [flaɪ]","ru": "летать" }
          ]
        },
        {
          "title": "Четыре варианта magic e",
          "borderColor": "term",
