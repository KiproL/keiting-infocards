          "callout": {
            "type": "warning",
            "title": "Внимание",
            "text": "Краткий [ʊ] в oo — короткий список слов, которые надо просто выучить: book, look, foot, good, cook, wood."
          },
          "examples": [
            { "en": "Book [bʊk]", "ru": "книга" },
            { "en": "Look [lʊk]", "ru": "смотреть" },
            { "en": "Foot [fʊt]", "ru": "ступня" },
            { "en": "Good [ɡʊd]", "ru": "хороший" }
          ]
        }
      ],
      "expandables": [
        {
          "label": "Осторожно: у ea есть варианты",
          "preview": "ea → [e] · ea → [eɪ]",
          "initiallyExpanded": false,
          "section": {
            "title": "",
            "borderColor": "bad",
            "rules": [
              { "name": "ea → [iː]", "suffix": "самый частый", "example": "tea, sea, dream, clean" },
              { "name": "ea → [e]",  "suffix": "в коротком списке", "example": "bread, head, ready, dead" },
              { "name": "ea → [eɪ]", "suffix": "редкие исключения",  "example": "great, break, steak" }
            ],
            "callout": {
              "type": "tip",
              "title": "Правило большого пальца",
              "text": "ee — практически всегда [iː] без исключений. С ea приходится проверять по словарю."
            }
          }
        }
      ]
    },

    {
      "label": "oa / ai / ay",
      "intro": {
        "text": "Oa и долгое ow читаются как [əʊ]. Ai и ay — как [eɪ]. Всё зависит от позиции в слове.",
        "highlights": [
          { "text": "Oa",     "color": "example", "style": "bold" },
          { "text": "[əʊ]",   "color": "term",    "style": "bold_underline" },
          { "text": "Ai / ay","color": "info",    "style": "bold" },
          { "text": "[eɪ]",   "color": "example", "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Oa / ow → [əʊ]",
          "borderColor": "term",
          "examples": [
            { "en": "Boat   [bəʊt]",     "ru": "лодка" },
            { "en": "Snow   [snəʊ]",     "ru": "снег" },
            { "en": "Yellow [ˈjeləʊ]",   "ru": "жёлтый" },
            { "en": "Road   [rəʊd]",     "ru": "дорога" }
          ]
        },
        {
          "title": "Ai — в середине слова",
          "borderColor": "info",
          "examples": [
            { "en": "Rain  [reɪn]",  "ru": "дождь" },
            { "en": "Train [treɪn]", "ru": "поезд" },
            { "en": "Wait  [weɪt]",  "ru": "ждать" },
            { "en": "Pain  [peɪn]",  "ru": "боль" }
          ]
        },
        {
          "title": "Ay — в конце слова",
          "borderColor": "example",
          "examples": [
            { "en": "Day  [deɪ]",  "ru": "день" },
            { "en": "Play [pleɪ]", "ru": "играть" },
            { "en": "Stay [steɪ]", "ru": "оставаться" },
            { "en": "May  [meɪ]",  "ru": "май / мочь" }
          ]
        },
        {
          "title": "Позиция решает",
          "borderColor": "good",
          "rules": [
            { "name": "ai в середине",  "suffix": "[eɪ]",  "example": "rain, train, wait, fail" },
            { "name": "ay в конце",     "suffix": "[eɪ]",  "example": "day, play, stay, way" },
            { "name": "oa в середине",  "suffix": "[əʊ]",  "example": "boat, road, coat, goat" },
            { "name": "ow в конце",     "suffix": "[əʊ]",  "example": "snow, slow, yellow, window" }
          ]
        },
        {
          "title": "Внимание: ow бывает и [aʊ]",
          "borderColor": "bad",
          "callout": {
            "type": "warning",
            "title": "Два звука ow",
            "text": "ow = [əʊ] в snow, slow, yellow. ow = [aʊ] в cow, how, now, down. Определяется только по слову."
          },
          "examples": [
            { "en": "Snow [snəʊ] — [əʊ]", "ru": "снег" },
            { "en": "Cow  [kaʊ]  — [aʊ]", "ru": "корова" }
          ]
        }
      ]
    },

