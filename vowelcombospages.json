            { "en": "Sleep [sliːp]",  "ru": "спать" },
            { "en": "Free  [friː]",   "ru": "свободный" }
          ]
        },
        {
          "title": "Ea → [iː]",
          "borderColor": "example",
          "examples": [
            { "en": "Tea   [tiː]",  "ru": "чай" },
            { "en": "Sea   [siː]",  "ru": "море" },
            { "en": "Read  [riːd]", "ru": "читать" },
            { "en": "Dream [driːm]","ru": "мечта" }
          ]
        },
        {
          "title": "Oo → [uː] — долгий",
          "borderColor": "info",
          "examples": [
            { "en": "Moon   [muːn]",  "ru": "луна" },
            { "en": "Food   [fuːd]",  "ru": "еда" },
