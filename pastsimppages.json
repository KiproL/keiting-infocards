            {
              "name": "Немая -e",
              "suffix": "+ d",
              "example": "live → lived, like → liked"
            },
            {
              "name": "Гласная + согл. в конце",
              "suffix": "удвоение + ed",
              "example": "stop → stopped, plan → planned"
            },
            {
              "name": "Согласная + y",
              "suffix": "y → ied",
              "example": "study → studied, cry → cried"
            },
            {
              "name": "Гласная + y",
              "suffix": "+ ed",
              "example": "play → played, stay → stayed"
