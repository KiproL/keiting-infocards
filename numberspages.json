    {
      "label": "Cardinal / Ordinal",
      "intro": {
        "text": "Cardinal — «сколько?». Ordinal — «какой по счёту?».",
        "highlight": "Cardinal",
        "highlightColor": "info"
      },
      "sections": [
        { "title": "Cardinal Numbers", "examples": [
          { "en": "one, two, three, four, five…", "ru": "один, два, три, четыре, пять" }
        ]},
        { "title": "Ordinal Numbers", "examples": [
          { "en": "first, second, third, fourth…", "ru": "первый, второй, третий…" }
        ]},
        { "title": "Где используются порядковые", "bullets": [
          { "text": "Даты: the first of May", "color": "example" },
          { "text": "Этажи: the third floor", "color": "info" },
          { "text": "Места: She came second", "color": "term" }
        ]},
        {
          "title": "Артикль перед порядковым",
          "borderColor": "term",
          "text": "Обычно the: the first, the second.",
          "textColor": "text"
        }
      ]
    },

