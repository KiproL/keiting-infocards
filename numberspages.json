              { "en": "THIRty    [ˈθɜːti]",   "ru": "30 — ударение в начале" },
              { "en": "fourTEEN  [fɔːˈtiːn]", "ru": "14 — ударение в конце" },
              { "en": "FORty     [ˈfɔːti]",   "ru": "40 — ударение в начале" },
              { "en": "fifTEEN   [fɪfˈtiːn]", "ru": "15 — ударение в конце" },
              { "en": "FIFty     [ˈfɪfti]",   "ru": "50 — ударение в начале" }
            ]
          }
        }
      ]
    }
  ]
}
