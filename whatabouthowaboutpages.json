            { "en": "How about going to the beach?",      "ru": "Как насчёт пойти на пляж?" },
            { "en": "What about having dinner together?",  "ru": "Как насчёт поужинать вместе?" },
            { "en": "How about a walk in the park?",        "ru": "Как насчёт прогулки в парке?" },
            { "en": "What about tomorrow evening?",         "ru": "Как насчёт завтра вечером?" }
          ]
