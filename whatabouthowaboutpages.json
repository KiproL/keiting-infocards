          { "text": "существительное",           "color": "bad",     "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Формула",
          "borderColor": "term",
          "formulaCard": {
            "parts": [
              { "text": "What / How about", "color": "info" },
              { "text": "+",                "color": "muted" },
              { "text": "-ing / сущ.?",     "color": "example" }
