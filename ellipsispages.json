      "practice": [
        {"en": "Will it rain tomorrow? — I [hope not].", "ru": "Завтра будет дождь? — Надеюсь, что нет.", "why": "hope not — надеюсь, нет", "level": "B1"},
        {"en": "Is he coming? — I [think so].", "ru": "Он придёт? — Думаю, да.", "why": "think so — думаю, да", "level": "A2"},
