          "title": "Совет",
          "borderColor": "good",
          "callout": {
            "type": "tip",
            "title": "Как различить",
            "text": "Привык — be used to + -ing. Раньше делал — used to + глагол. Есть am, is, was — значит, речь о привычке."
          }
