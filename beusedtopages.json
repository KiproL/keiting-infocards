        {
          "title": "Почему -ing",
          "borderColor": "term",
          "callout": {
            "type": "info",
            "title": "To здесь — предлог",
            "text": "To в be used to значит «к»: привык к шуму, привык к работе. Поэтому после него -ing или существительное: used to working, used to the noise."
          }
        },
        {
          "title": "Used to или be used to",
          "borderColor": "info",
          "examples": [
            {
              "en": "I used to wake up early.",
              "ru": "Раньше я рано вставал — теперь нет."
            },
            {
              "en": "I'm used to waking up early.",
              "ru": "Я привык рано вставать — и мне это нормально."
            }
          ],
          "text": "Прошлые привычки подробно — в карточке «Used to»."
        },
        {
          "title": "Состояние или процесс",
          "borderColor": "info",
          "examples": [
            {
              "en": "I'm used to the noise now.",
              "ru": "Я уже привык к шуму — состояние."
            },
            {
              "en": "I'm getting used to the noise.",
              "ru": "Я привыкаю к шуму — процесс, карточка «Get used to»."
            }
          ]
        },
        {
          "title": "Живые примеры",
          "borderColor": "good",
          "examples": [
            {
              "en": "I'm used to living alone.",
              "ru": "Я привык жить один."
            },
            {
              "en": "She's used to cold weather.",
              "ru": "Она привыкла к холоду."
            },
            {
