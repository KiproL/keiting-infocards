    {
      "label": "Просьбы и советы",
      "intro": {
        "text": "Просьбу или приказ пересказывают через to + глагол: «Сядь!» → He told me to sit down. Отказ — not to. А кроме said и told есть глаголы точнее: advised, warned, promised.",
        "highlights": [
          {
            "text": "to + глагол",
            "color": "term",
            "style": "bold_underline"
          },
          {
            "text": "not to",
            "color": "bad",
            "style": "bold"
          },
          {
            "text": "advised, warned, promised",
            "color": "info",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Формула",
          "borderColor": "term",
          "formulaCard": {
            "parts": [
              {
                "text": "told / asked",
                "color": "info"
              },
              {
                "text": "+",
                "color": "muted"
              },
              {
                "text": "кого",
                "color": "example"
              },
              {
                "text": "+",
                "color": "muted"
              },
              {
                "text": "(not) to",
                "color": "term"
              },
              {
                "text": "+",
                "color": "muted"
              },
              {
                "text": "глагол",
                "color": "text"
