            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Можно оставить время",
          "borderColor": "info",
          "rules": [
            {
              "name": "Глагол-пересказ в настоящем",
              "suffix": "says / has said",
              "example": "She says she is tired."
            },
            {
              "name": "Общая истина",
              "suffix": "факт навсегда",
