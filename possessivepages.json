            "color": "term",
            "style": "bold_underline"
          }
        ]
      },
      "sections": [
        {
          "title": "Вопрос Whose",
          "borderColor": "info",
          "examples": [
            {
              "en": "Whose phone is this?",
              "ru": "Чей это телефон?"
            },
            {
              "en": "Whose is this coat? — It's Tom's.",
              "ru": "Чьё это пальто? — Тома."
            },
            {
              "en": "Who's that man? — It's my uncle.",
              "ru": "Кто этот мужчина? — Мой дядя: who's = who is."
            }
          ]
        },
