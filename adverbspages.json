              "suffix": "y → ily",
              "example": "easy → easily, happy → happily"
            },
            {
              "name": "-le",
              "suffix": "e → y",
              "example": "gentle → gently, terrible → terribly"
            },
            {
              "name": "-ic",
              "suffix": "+ ally",
              "example": "basic → basically"
            },
            {
              "name": "-ful",
              "suffix": "+ ly",
              "example": "careful → carefully"
            }
          ]
        },
        {
          "title": "Не каждое -ly — наречие",
          "borderColor": "bad",
          "callout": {
            "type": "warning",
            "title": "Friendly, lovely, lonely",
            "text": "Friendly, lovely, lonely, silly, ugly — прилагательные: a friendly smile. «Дружелюбно» — in a friendly way."
