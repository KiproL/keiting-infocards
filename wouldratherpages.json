            { "wrong": "I'd rather to stay.",       "right": "I'd rather stay." },
            { "wrong": "I'd rather staying home.",   "right": "I'd rather stay home." },
            { "wrong": "I'd rather I go home.",       "right": "I'd rather go home." }
          ]
        },
        {
          "title": "Совет",
          "borderColor": "good",
          "callout": {
            "type": "tip",
            "title": "Простой тест",
            "text": "После would rather всегда чистый глагол без to и без -ing. То же правило, что и у модальных глаголов."
          }
        }
      ]
