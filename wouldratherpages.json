            "accentColor": "accent2"
          }
        }
      ],
      "practice": [
        {"en": "I'd rather [stay] in tonight.", "ru": "Я бы лучше сегодня посидел дома.", "why": "would rather + глагол без to", "level": "B1"},
        {"en": "She'd rather [walk] than drive.", "ru": "Она лучше пройдётся, чем поедет на машине.", "why": "would rather … than — выбор из двух", "level": "B1"},
        {"en": "I'd rather [not] go out in this rain.", "ru": "Я бы не стал выходить в такой дождь.", "why": "would rather not — отрицание", "level": "B1"},
