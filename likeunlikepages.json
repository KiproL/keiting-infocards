{
  "tenseName": "Like / Unlike",
  "route": "cards_likeunlike",
  "slides": [
    {
      "label": "Что это",
      "intro": {
        "text": "Like — сравнение через сходство: «как», «похожий на». Unlike — сравнение через различие: «в отличие от». Это не глагол like «нравится».",
        "highlights": [
          { "text": "Like",     "color": "info",    "style": "bold" },
          { "text": "Unlike",   "color": "bad",     "style": "bold" },
          { "text": "сходство",  "color": "example", "style": "bold_underline" },
          { "text": "различие",  "color": "term",    "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Формулы",
          "borderColor": "term",
          "formulas": [
            {
              "parts": [
                { "text": "Like",   "color": "info" },
                { "text": "+",      "color": "muted" },
                { "text": "сущ.",   "color": "example" },
                { "text": "= как",  "color": "term" }
              ],
              "accentColor": "info"
            },
            {
              "parts": [
                { "text": "Unlike",  "color": "bad" },
                { "text": "+",       "color": "muted" },
                { "text": "сущ.",    "color": "example" },
                { "text": "= в отличие", "color": "term" }
              ],
              "accentColor": "bad"
            }
          ]
        },
        {
          "title": "Сравнение",
          "borderColor": "info",
          "table": {
            "headers": ["Форма", "Смысл", "Пример"],
            "headerColors": ["info", "example", "term"],
            "rows": [
              { "cells": ["like",   "как, похожий на",  "He swims like a fish."] },
              { "cells": ["unlike", "в отличие от",      "Unlike me, she loves mornings."] },
              { "cells": ["like",   "похоже на",         "It looks like rain."] },
              { "cells": ["unlike", "не так, как",        "Unlike you, I hate coffee."] }
            ],
            "borderColor": "info"
          }
        },
        {
          "title": "Живые примеры",
          "borderColor": "good",
          "examples": [
            { "en": "He swims like a fish.",                  "ru": "Он плавает как рыба." },
            { "en": "Unlike me, she loves mornings.",          "ru": "В отличие от меня, она любит утро." },
            { "en": "It looks like rain.",                      "ru": "Похоже на дождь." },
            { "en": "Unlike you, I hate coffee.",                "ru": "В отличие от тебя, я не люблю кофе." }
          ]
        }
      ],
      "practice": [
        {"en": "She sings [like] an angel.", "ru": "Она поёт как ангел.", "why": "like — как, похоже", "level": "B1"},
        {"en": "[Unlike] his brother, Tom is very quiet.", "ru": "В отличие от брата, Том очень тихий.", "why": "unlike — в отличие от", "level": "B1"},
        {"en": "It smells [like] chocolate.", "ru": "Пахнет шоколадом.", "why": "like — как, похоже", "level": "B1"},
        {"en": "[Unlike] most people, I love Mondays.", "ru": "В отличие от большинства, я люблю понедельники.", "why": "unlike — в отличие от", "level": "B1"},
        {"en": "You look [like] your mum.", "ru": "Ты похож на маму.", "why": "like — как, похоже", "level": "A2"},
        {"en": "[Unlike] London, our town is very quiet.", "ru": "В отличие от Лондона, наш город очень тихий.", "why": "unlike — в отличие от", "level": "B1"}
      ]
    },

    {
      "label": "Like vs As",
      "intro": {
        "text": "Like и as часто путают. Like — сравнение, as — роль или функция. Два разных слова.",
        "highlights": [
          { "text": "Like", "color": "info", "style": "bold" },
          { "text": "As",   "color": "term", "style": "bold" },
          { "text": "роль",  "color": "example", "style": "bold_underline" }
        ]
      },
      "sections": [
        {
          "title": "Разница",
          "borderColor": "term",
          "table": {
            "headers": ["Форма", "Смысл", "Пример"],
            "headerColors": ["info", "example", "term"],
            "rows": [
              { "cells": ["like", "похожий на", "He works like a machine."] },
              { "cells": ["as",   "в роли, в качестве", "He works as a doctor."] }
            ],
            "borderColor": "term"
          }
        },
        {
          "title": "Ошибки",
          "borderColor": "bad",
          "errors": [
            { "wrong": "He works like a doctor. (если он врач)", "right": "He works as a doctor." },
            { "wrong": "Unlike to me, she loves mornings.",       "right": "Unlike me, she loves mornings." },
            { "wrong": "Like me, she doesn't like coffee.",        "right": "Like me, she doesn't like coffee." }
          ]
        },
        {
          "title": "Совет",
          "borderColor": "good",
          "callout": {
            "type": "tip",
            "title": "Как различить",
            "text": "Like — похож. As — на самом деле в этой роли. Если человек и есть врач — as a doctor. Если только выглядит как врач — like a doctor."
          },
          "quote": {
            "text": "Like — про сходство. Unlike — про разницу. As — про реальную роль.",
            "author": "правило большого пальца",
            "accentColor": "accent2"
          }
        }
      ],
      "practice": [
        {"en": "She works [as] a teacher.", "ru": "Она работает учителем.", "why": "as — на самом деле в этой роли", "level": "B1"},
        {"en": "He eats [like] a horse.", "ru": "Он ест как лошадь.", "why": "like — только похож", "level": "B1"},
        {"en": "I used my coat [as] a pillow.", "ru": "Я использовал пальто вместо подушки.", "why": "as — на самом деле в этой роли", "level": "B1"},
        {"en": "She talks [like] a lawyer.", "ru": "Она говорит как юрист.", "why": "like — только похож", "level": "B1"},
        {"en": "He came to the party [as] a pirate.", "ru": "Он пришёл на вечеринку в костюме пирата.", "why": "as — на самом деле в этой роли", "level": "B2"}
      ]
    }
  ]
}
