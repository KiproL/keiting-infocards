      "sections": [
        {
          "title": "Как слова соединяются",
          "borderColor": "info",
          "rules": [
            {
              "name": "согласный + гласный",
              "suffix": "сливаются",
              "example": "an apple → «энэпл»"
            },
            {
              "name": "i, e + гласный",
              "suffix": "вставляется [j]",
              "example": "I agree → «ай йэгри»"
            },
            {
              "name": "u, o + гласный",
              "suffix": "вставляется [w]",
              "example": "go out → «гоу уаут»"
            },
            {
              "name": "r на конце (брит.)",
              "suffix": "звучит перед гласным",
              "example": "far away → «фа рэуэй»"
            }
          ]
        }
