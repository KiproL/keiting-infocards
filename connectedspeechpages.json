    {
      "label": "Связки",
      "intro": {
        "text": "Согласный на конце слова цепляется к гласному следующего: turn it off звучит как «тёрни тоф». Между двумя гласными вставляется лёгкий [j] или [w].",
        "highlights": [
          {
            "text": "цепляется",
            "color": "term",
            "style": "bold"
          },
          {
            "text": "[j] или [w]",
            "color": "info",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Как слова соединяются",
          "borderColor": "info",
          "rules": [
            {
              "name": "согласный + гласный",
              "suffix": "сливаются",
              "example": "an apple → «энэпл»"
            },
            {
              "name": "i, e + гласный",
              "suffix": "вставляется [j]",
              "example": "I agree → «ай йэгри»"
            },
            {
              "name": "u, o + гласный",
              "suffix": "вставляется [w]",
              "example": "go out → «гоу уаут»"
            },
            {
              "name": "r на конце (брит.)",
              "suffix": "звучит перед гласным",
              "example": "far away → «фа рэуэй»"
            }
          ]
        }
      ],
      "practice": [
        {"en": "Please turn [it off].", "ru": "Пожалуйста, выключи это.", "why": "согласный + гласный — сливаются", "level": "B1"},
        {"en": "Can I have [an apple]?", "ru": "Можно мне яблоко?", "why": "согласный + гласный — сливаются", "level": "A2"},
        {"en": "[I agree] with you.", "ru": "Я с тобой согласен.", "why": "i, e + гласный — вставляется [j]", "level": "B1"},
        {"en": "Let's [go out] tonight.", "ru": "Давай сходим куда-нибудь вечером.", "why": "u, o + гласный — вставляется [w]", "level": "B1"},
        {"en": "The shop is [far away].", "ru": "Магазин далеко.", "why": "r на конце звучит перед гласным", "level": "B1"},
        {"en": "Pick [it up], please.", "ru": "Подними это, пожалуйста.", "why": "согласный + гласный — сливаются", "level": "B1"}
      ]
    },
