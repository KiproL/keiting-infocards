    {
      "label": "Оценки: cool, sick",
      "intro": {
        "text": "Друг показывает трюк на скейте: That's sick! — это не «тошнотворно», а «огонь, круто!». Сленг часто даёт обычным словам новый смысл.",
        "highlights": [
          {
            "text": "That's sick!",
            "color": "example",
            "style": "bold"
          },
          {
            "text": "новый смысл",
            "color": "term",
            "style": "bold_underline"
          }
        ]
      },
      "sections": [
        {
          "title": "Хорошо и плохо",
          "borderColor": "info",
          "rules": [
            {
              "name": "cool, awesome",
              "suffix": "круто",
              "example": "That's so cool!"
            },
            {
              "name": "sick, epic",
              "suffix": "огонь",
              "example": "That trick was sick!"
            },
            {
              "name": "legit",
              "suffix": "настоящий, честный",
              "example": "Is this site legit?"
            },
            {
              "name": "lame",
              "suffix": "отстой, скучно",
              "example": "The party was lame."
            },
            {
              "name": "sketchy",
              "suffix": "мутный, стрёмный",
              "example": "This street looks sketchy at night."
            },
            {
              "name": "gross",
              "suffix": "фу, мерзко",
              "example": "Ew, that's gross!"
            }
          ]
        },
        {
          "title": "Старое слово — новый смысл",
          "borderColor": "term",
          "callout": {
            "type": "info",
            "title": "Смысл подсказывает ситуация",
            "text": "Sick — «больной» и «круто», cool — «прохладный» и «классный». Если человек улыбается и показывает видео, sick — это похвала."
          }
        },
        {
          "title": "Живые примеры",
          "borderColor": "good",
          "examples": [
            {
              "en": "The concert was awesome!",
              "ru": "Концерт был потрясающий!"
            },
            {
              "en": "No way, is that legit?",
              "ru": "Да ладно, это правда?"
            },
            {
              "en": "This place is kind of sketchy.",
              "ru": "Место какое-то мутное."
            }
          ]
        }
      ]
