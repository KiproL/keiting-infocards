    {
      "label": "Как добавить -ing",
      "intro": {
        "text": "Окончание -ing одинаковое для всех лиц. Как его писать, зависит от последних букв глагола: make → making, run → running.",
        "highlights": [
          {
            "text": "-ing",
            "color": "term",
            "style": "bold"
          },
          {
            "text": "одинаковое для всех",
            "color": "info",
            "style": "bold"
          },
          {
            "text": "последних букв",
            "color": "example",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Правила",
          "borderColor": "info",
          "rules": [
            {
              "name": "Большинство",
              "suffix": "+ ing",
              "example": "play → playing, read → reading"
            },
            {
              "name": "Немая -e",
              "suffix": "e убирается + ing",
              "example": "make → making, write → writing"
            },
            {
              "name": "Гласная + согл. в конце",
              "suffix": "удвоение + ing",
              "example": "run → running, sit → sitting"
            },
            {
              "name": "Глаголы на -ie",
              "suffix": "ie → y + ing",
              "example": "lie → lying, die → dying"
            }
          ]
        },
        {
          "title": "Исключение",
          "borderColor": "term",
          "table": {
            "headers": [
              "Глагол",
              "V-ing",
              "Перевод"
            ],
