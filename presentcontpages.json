                  "seeing",
                  "видеть"
                ]
              },
              {
                "cells": [
                  "agree",
                  "agreeing",
                  "соглашаться"
                ]
              }
            ],
            "borderColor": "term"
          },
          "callout": {
            "type": "tip",
            "title": "ee не сокращается",
            "text": "Если слово оканчивается на -ee (see, agree), то -e сохраняется: see → seeing, agree → agreeing."
          }
        },
