    {
      "label": "Как пересказать",
      "intro": {
        "text": "Сначала пойми, что человек сделал словами: предложил, отказался, признал. Потом подставь нужный глагол и его схему.",
        "highlights": [
          {
            "text": "что человек сделал словами",
            "color": "term",
            "style": "bold_underline"
          }
        ]
      },
      "sections": [
        {
          "title": "Прямая речь → пересказ",
          "borderColor": "term",
          "transforms": [
            {
              "from": "\"I'll help you,\" he said.",
              "to": "He offered to help me.",
              "toColor": "good"
            },
            {
              "from": "\"I didn't take it,\" she said.",
              "to": "She denied taking it.",
              "toColor": "good"
            },
            {
              "from": "\"Let's go to the cinema,\" Tom said.",
              "to": "Tom suggested going to the cinema.",
              "toColor": "good"
            },
            {
              "from": "\"You lied to me!\" she said to him.",
              "to": "She accused him of lying to her.",
              "toColor": "good"
            },
            {
              "from": "\"Don't touch the wire,\" he told us.",
              "to": "He warned us not to touch the wire.",
              "toColor": "good"
            }
          ]
        },
        {
          "title": "Suggest",
          "borderColor": "bad",
          "callout": {
            "type": "warning",
            "text": "После suggest нельзя человек + to. Говорят suggested going или suggested that we (should) go.",
            "title": "Ловушка"
          }
        }
      ]
    },
    {
      "label": "Частые ошибки",
      "intro": {
        "text": "Частые ошибки с глаголами пересказа. Справа — как правильно и почему.",
        "highlights": [
          {
            "text": "Частые ошибки",
            "color": "bad",
            "style": "bold_underline"
          }
        ]
      },
      "sections": [
        {
          "title": "Слева — нельзя, справа — правильно",
          "borderColor": "bad",
          "errors": [
            {
              "wrong": "She suggested me to go home.",
              "right": "She suggested that I go home. (suggest — без человек + to)"
            },
            {
              "wrong": "He denied to steal the money.",
              "right": "He denied stealing the money. (deny + -ing)"
            },
            {
              "wrong": "They accused him for lying.",
              "right": "They accused him of lying. (accuse of)"
            },
            {
              "wrong": "He apologised for be late.",
              "right": "He apologised for being late. (после for — -ing)"
            },
            {
              "wrong": "She insisted to pay.",
              "right": "She insisted on paying. (insist on + -ing)"
            }
          ]
        },
        {
          "title": "Совет",
          "borderColor": "good",
          "callout": {
            "type": "tip",
            "title": "Учи схемой",
            "text": "Запоминай не просто deny, а deny doing; не accuse, а accuse someone of doing. Тогда пересказ строится сам."
          }
        }
      ]
    }
