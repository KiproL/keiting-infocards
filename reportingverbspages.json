    {
      "label": "Как пересказать",
      "intro": {
        "text": "Сначала пойми, что человек сделал словами: предложил, отказался, признал. Потом подставь нужный глагол и его схему.",
        "highlights": [
          {
            "text": "что человек сделал словами",
            "color": "term",
            "style": "bold_underline"
          }
        ]
      },
      "sections": [
        {
          "title": "Прямая речь → пересказ",
          "borderColor": "term",
          "transforms": [
            {
              "from": "\"I'll help you,\" he said.",
              "to": "He offered to help me.",
              "toColor": "good"
            },
            {
              "from": "\"I didn't take it,\" she said.",
              "to": "She denied taking it.",
              "toColor": "good"
            },
            {
              "from": "\"Let's go to the cinema,\" Tom said.",
              "to": "Tom suggested going to the cinema.",
              "toColor": "good"
            },
            {
              "from": "\"You lied to me!\" she said to him.",
              "to": "She accused him of lying to her.",
              "toColor": "good"
            },
            {
              "from": "\"Don't touch the wire,\" he told us.",
              "to": "He warned us not to touch the wire.",
              "toColor": "good"
            }
          ]
        },
        {
          "title": "Suggest",
          "borderColor": "bad",
          "callout": {
            "type": "warning",
            "text": "После suggest нельзя человек + to. Говорят suggested going или suggested that we (should) go.",
            "title": "Ловушка"
          }
        }
      ]
