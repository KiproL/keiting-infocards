{
  "tenseName": "Частицы を・に・へ・で・と",
  "route": "cards_ja_particles2",
  "slides": [
    {
      "label": "を — что делаю",
      "intro": {
        "text": "を (читается «о») отмечает предмет действия: что ем, что пью, что смотрю.",
        "highlights": [
          {
            "text": "を",
            "color": "term",
            "style": "bold"
          },
          {
            "text": "«о»",
            "color": "info",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Примеры",
          "examples": [
            {
              "en": "パンを たべます。",
              "reading": "pan o tabemasu",
              "ru": "Ем хлеб."
            },
            {
              "en": "みずを のみます。",
              "reading": "mizu o nomimasu",
              "ru": "Пью воду."
            },
            {
              "en": "えいがを みます。",
              "reading": "eiga o mimasu",
              "ru": "Смотрю фильм."
            }
          ]
        }
      ]
    },
    {
      "label": "に и へ — куда, когда",
      "intro": {
        "text": "に — точка: время (в 7 часов), место, где что-то находится, и цель движения. へ (читается «э») — направление «в сторону».",
        "highlights": [
          {
            "text": "に",
            "color": "term",
            "style": "bold"
          },
          {
            "text": "へ",
            "color": "info",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Примеры",
          "examples": [
            {
              "en": "しちじに おきます。",
              "reading": "shichiji ni okimasu",
              "ru": "Встаю в 7 часов."
            },
            {
              "en": "がっこうに いきます。",
              "reading": "gakkō ni ikimasu",
              "ru": "Иду в школу."
            },
            {
              "en": "にほんへ いきます。",
              "reading": "nihon e ikimasu",
              "ru": "Еду в Японию."
            },
            {
              "en": "ともだちに あいます。",
              "reading": "tomodachi ni aimasu",
              "ru": "Встречаюсь с другом."
            }
          ]
        },
        {
          "title": "に или へ",
          "callout": {
            "type": "info",
            "text": "С いきます, きます, かえります можно и に, и へ — разница минимальная. へ подчёркивает направление."
          }
        }
      ]
    },
    {
      "label": "で — где и чем",
      "intro": {
        "text": "で — место, где происходит действие, и способ: на чём, чем, на каком языке.",
        "highlights": [
          {
            "text": "где происходит действие",
            "color": "term",
            "style": "bold"
          },
          {
            "text": "способ",
            "color": "info",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Примеры",
          "examples": [
            {
              "en": "うちで たべます。",
              "reading": "uchi de tabemasu",
              "ru": "Ем дома."
            },
            {
              "en": "としょかんで べんきょうします。",
              "reading": "toshokan de benkyō shimasu",
              "ru": "Занимаюсь в библиотеке."
            },
            {
              "en": "バスで いきます。",
              "reading": "basu de ikimasu",
              "ru": "Еду на автобусе."
            },
            {
              "en": "はしで たべます。",
              "reading": "hashi de tabemasu",
              "ru": "Ем палочками."
            },
            {
              "en": "にほんごで はなします。",
              "reading": "nihongo de hanashimasu",
              "ru": "Говорю по-японски."
            }
          ]
        }
      ]
    },
    {
      "label": "と, から, まで",
      "intro": {
        "text": "と — «и» в перечислении и «вместе с». から — «от, из», まで — «до».",
        "highlights": [
          {
            "text": "と",
            "color": "term",
            "style": "bold"
          },
          {
            "text": "から",
            "color": "info",
            "style": "bold"
          },
          {
            "text": "まで",
            "color": "example",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Примеры",
          "examples": [
            {
              "en": "パンと ミルクを かいます。",
              "reading": "pan to miruku o kaimasu",
              "ru": "Покупаю хлеб и молоко."
            },
            {
              "en": "ともだちと いきます。",
              "reading": "tomodachi to ikimasu",
              "ru": "Иду с другом."
            },
            {
              "en": "くじから ごじまで はたらきます。",
              "reading": "kuji kara goji made hatarakimasu",
              "ru": "Работаю с 9 до 5."
            }
          ]
        },
        {
