    },
    {
      "label": "Группа I",
      "intro": {
        "text": "Последний слог -u меняем на -i и добавляем ます: のむ nomu → のみます nomimasu.",
        "highlights": [
          {
            "text": "-u меняем на -i",
            "color": "term",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Словарная форма → ます",
          "transforms": [
            {
              "from": "かう — покупать",
              "to": "かいます"
            },
            {
              "from": "かく — писать",
              "to": "かきます"
            },
            {
              "from": "はなす — говорить",
              "to": "はなします"
            },
            {
              "from": "まつ — ждать",
              "to": "まちます"
            },
            {
              "from": "のむ — пить",
              "to": "のみます"
            },
            {
              "from": "かえる — возвращаться",
              "to": "かえります"
            }
          ]
        }
      ]
    },
    {
      "label": "Группы II и III",
      "intro": {
        "text": "Группа II — самая простая: убираем る и добавляем ます. Группу III просто запоминаем.",
        "highlights": [
          {
            "text": "убираем る",
            "color": "term",
            "style": "bold"
          },
          {
            "text": "запоминаем",
            "color": "info",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Группа II",
          "transforms": [
            {
              "from": "たべる — есть",
              "to": "たべます"
            },
            {
              "from": "みる — смотреть",
              "to": "みます"
            },
            {
              "from": "おきる — вставать",
              "to": "おきます"
            },
            {
              "from": "ねる — спать",
              "to": "ねます"
            }
          ]
        },
        {
          "title": "Группа III",
          "transforms": [
            {
              "from": "する — делать",
              "to": "します"
