      "style": "bold"
     }
    ]
   },
   "sections": [
    {
     "title": "Примеры",
     "examples": [
      {
       "en": "私は 学生です。",
       "reading": "わたしは がくせいです。 · watashi wa gakusei desu",
       "ru": "Я (что касается меня) — студент."
      },
      {
       "en": "今日は 暑いです。",
       "reading": "きょうは あついです。 · kyō wa atsui desu",
       "ru": "Сегодня жарко."
      }
     ]
    }
   ]
  },
  {
   "label": "が — кто именно",
