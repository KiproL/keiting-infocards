{
  "tenseName": "Вопросы",
  "route": "cards_ja_questions",
  "slides": [
    {
      "label": "Частица か",
      "intro": {
        "text": "Любое утверждение становится вопросом, если добавить в конце か. Интонация в конце поднимается.",
        "highlights": [
          {
            "text": "か",
            "color": "term",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Утверждение → вопрос",
          "transforms": [
            {
              "from": "がくせいです。",
              "to": "がくせいですか。"
            },
            {
              "from": "にほんへ いきます。",
              "to": "にほんへ いきますか。"
            }
          ]
        },
        {
          "title": "Ответы",
          "examples": [
            {
              "en": "はい、いきます。",
              "reading": "hai, ikimasu",
              "ru": "Да, поеду."
            },
            {
              "en": "いいえ、いきません。",
              "reading": "iie, ikimasen",
              "ru": "Нет, не поеду."
            }
          ]
        }
      ]
    },
    {
      "label": "Вопросительные слова",
      "intro": {
        "text": "Вопросительное слово встаёт на место ответа — порядок слов не меняется: これは ほんです → これは なんですか.",
        "highlights": [
          {
            "text": "на место ответа",
            "color": "term",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Нажми, чтобы послушать",
          "verbGrid": {
            "verbs": [
              "なに nani — что",
              "だれ dare — кто",
              "どこ doko — где",
              "いつ itsu — когда",
              "いくら ikura — сколько стоит",
              "いくつ ikutsu — сколько штук",
              "どれ dore — который",
              "どう dō — как",
              "どうして dōshite — почему"
            ]
          }
        },
        {
          "title": "Примеры",
          "examples": [
            {
              "en": "これは いくらですか。",
              "reading": "kore wa ikura desu ka",
              "ru": "Сколько это стоит?"
            },
            {
              "en": "いつ にほんへ いきますか。",
              "reading": "itsu nihon e ikimasu ka",
              "ru": "Когда поедешь в Японию?"
            },
            {
              "en": "あの ひとは だれですか。",
              "reading": "ano hito wa dare desu ka",
              "ru": "Кто тот человек?"
            },
            {
              "en": "なにを たべますか。",
              "reading": "nani o tabemasu ka",
              "ru": "Что будешь есть?"
            }
          ]
        }
      ]
    },
    {
      "label": "なに или なん",
      "intro": {
        "text": "«Что» бывает なに и なん. なん — перед です, перед の и перед счётными словами; в остальных случаях — なに.",
        "highlights": [
          {
            "text": "なに",
            "color": "term",
            "style": "bold"
          },
          {
            "text": "なん",
            "color": "info",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Когда какое",
          "table": {
            "headers": [
              "Форма",
              "Когда",
              "Пример"
            ],
            "rows": [
              {
                "cells": [
                  "なん",
                  "перед です",
                  "これは なんですか — что это?"
                ]
              },
              {
                "cells": [
                  "なん",
                  "перед счётным словом",
                  "なんじ — который час?"
                ]
              },
              {
                "cells": [
                  "なに",
                  "перед を, が и другими",
                  "なにを のみますか — что будешь пить?"
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
