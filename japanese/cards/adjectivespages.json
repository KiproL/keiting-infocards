          },
          {
            "text": "на な",
            "color": "info",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "い-прилагательные",
          "verbGrid": {
            "verbs": [
              "たかい — дорогой; высокий",
              "やすい — дешёвый",
              "おおきい — большой",
              "ちいさい — маленький",
              "あつい — жаркий",
              "さむい — холодный",
              "おいしい — вкусный",
              "たのしい — весёлый"
            ]
          }
        },
        {
          "title": "な-прилагательные",
          "verbGrid": {
            "verbs": [
              "しずか — тихий",
              "きれい — красивый; чистый",
              "げんき — бодрый, здоровый",
              "ゆうめい — известный",
              "べんり — удобный",
              "すき — любимый"
            ]
          }
        },
        {
          "title": "Ловушка",
          "callout": {
            "type": "warning",
            "text": "きれい и ゆうめい оканчиваются на い, но это な-прилагательные: きれいな はな — красивый цветок."
          }
        }
      ]
    },
    {
      "label": "Перед словом",
      "intro": {
        "text": "い-прилагательное ставим перед существительным как есть, а к な-прилагательному добавляем な.",
        "highlights": [
          {
            "text": "как есть",
            "color": "term",
            "style": "bold"
          },
          {
            "text": "добавляем な",
            "color": "info",
            "style": "bold"
          }
        ]
      },
