  {"id": "phrase_ja_n5_0036", "word": "おめでとうございます。", "kana": "おめでとうございます。", "romaji": "omedetō gozaimasu.", "pos": "expr", "level": "N5", "topic": "greetings", "ru": "Поздравляю!", "en": "Congratulations!"},
