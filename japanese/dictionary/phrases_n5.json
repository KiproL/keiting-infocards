  {"id": "phrase_ja_n5_0003", "word": "お名前は何ですか。", "kana": "おなまえはなんですか。", "romaji": "o-namae wa nan desu ka.", "pos": "expr", "level": "N5", "topic": "people", "ru": "Как вас зовут?", "en": "What is your name?"},
