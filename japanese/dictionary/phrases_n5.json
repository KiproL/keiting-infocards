  {"id": "phrase_ja_n5_0091", "word": "頭が 痛いです。", "kana": "あたまが いたいです。", "romaji": "atama ga itai desu.", "pos": "expr", "level": "N5", "topic": "body", "ru": "Болит голова.", "en": "I have a headache."},
  {"id": "phrase_ja_n5_0092", "word": "助けて！", "kana": "たすけて！", "romaji": "tasukete!", "pos": "expr", "level": "N5", "topic": "body", "ru": "Помогите!", "en": "Help!"},
  {"id": "phrase_ja_n5_0093", "word": "ちょっと 待って ください。", "kana": "ちょっと まって ください。", "romaji": "chotto matte kudasai.", "pos": "expr", "level": "N5", "topic": "time", "ru": "Подождите немного.", "en": "Please wait a moment."},
  {"id": "phrase_ja_n5_0094", "word": "今 何時ですか。", "kana": "いま なんじですか。", "romaji": "ima nanji desu ka.", "pos": "expr", "level": "N5", "topic": "time", "ru": "Который час?", "en": "What time is it?"},
  {"id": "phrase_ja_n5_0095", "word": "そうですか。", "kana": "そうですか。", "romaji": "sō desu ka.", "pos": "expr", "level": "N5", "topic": "greetings", "ru": "Вот как.", "en": "I see."},
