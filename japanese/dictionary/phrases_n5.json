  {"id": "phrase_ja_n5_0077", "word": "ゆっくり 話して ください。", "kana": "ゆっくり はなして ください。", "romaji": "yukkuri hanashite kudasai.", "pos": "expr", "level": "N5", "topic": "greetings", "ru": "Говорите медленнее, пожалуйста.", "en": "Please speak slowly."},
  {"id": "phrase_ja_n5_0078", "word": "英語が 話せますか。", "kana": "えいごが はなせますか。", "romaji": "eigo ga hanasemasu ka.", "pos": "expr", "level": "N5", "topic": "greetings", "ru": "Вы говорите по-английски?", "en": "Do you speak English?"},
  {"id": "phrase_ja_n5_0079", "word": "日本語は 少しだけです。", "kana": "にほんごは すこしだけです。", "romaji": "nihongo wa sukoshi dake desu.", "pos": "expr", "level": "N5", "topic": "greetings", "ru": "По-японски я чуть-чуть.", "en": "Only a little Japanese."},
  {"id": "phrase_ja_n5_0080", "word": "また 明日。", "kana": "また あした。", "romaji": "mata ashita.", "pos": "expr", "level": "N5", "topic": "greetings", "ru": "До завтра.", "en": "See you tomorrow."},
  {"id": "phrase_ja_n5_0081", "word": "じゃあ、 また。", "kana": "じゃあ、 また。", "romaji": "jā, mata.", "pos": "expr", "level": "N5", "topic": "greetings", "ru": "Ну, пока.", "en": "See you."},
  {"id": "phrase_ja_n5_0082", "word": "気を つけて。", "kana": "きを つけて。", "romaji": "ki o tsukete.", "pos": "expr", "level": "N5", "topic": "greetings", "ru": "Береги себя / осторожно.", "en": "Take care."},
  {"id": "phrase_ja_n5_0083", "word": "おめでとう ございます。", "kana": "おめでとう ございます。", "romaji": "omedetō gozaimasu.", "pos": "expr", "level": "N5", "topic": "greetings", "ru": "Поздравляю!", "en": "Congratulations!"},
  {"id": "phrase_ja_n5_0084", "word": "誕生日 おめでとう。", "kana": "たんじょうび おめでとう。", "romaji": "tanjōbi omedetō.", "pos": "expr", "level": "N5", "topic": "greetings", "ru": "С днём рождения!", "en": "Happy birthday!"},
  {"id": "phrase_ja_n5_0085", "word": "あけまして おめでとう ございます。", "kana": "あけまして おめでとう ございます。", "romaji": "akemashite omedetō gozaimasu.", "pos": "expr", "level": "N5", "topic": "greetings", "ru": "С Новым годом!", "en": "Happy New Year!"},
  {"id": "phrase_ja_n5_0086", "word": "いい 天気ですね。", "kana": "いい てんきですね。", "romaji": "ii tenki desu ne.", "pos": "expr", "level": "N5", "topic": "nature", "ru": "Хорошая погода, правда?", "en": "Nice weather, isn't it?"},
  {"id": "phrase_ja_n5_0087", "word": "暑いですね。", "kana": "あついですね。", "romaji": "atsui desu ne.", "pos": "expr", "level": "N5", "topic": "nature", "ru": "Жарко, да?", "en": "It's hot, isn't it?"},
  {"id": "phrase_ja_n5_0088", "word": "おなかが すきました。", "kana": "おなかが すきました。", "romaji": "onaka ga sukimashita.", "pos": "expr", "level": "N5", "topic": "food", "ru": "Я проголодался.", "en": "I'm hungry."},
