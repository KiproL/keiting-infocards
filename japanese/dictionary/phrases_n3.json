[
  {"id": "phrase_ja_n3_0001", "word": "お待たせしました。", "kana": "おまたせしました。", "romaji": "o-matase shimashita.", "pos": "expr", "level": "N3", "topic": "time", "ru": "Простите, что заставил ждать.", "en": "Sorry to keep you waiting."},
  {"id": "phrase_ja_n3_0002", "word": "お世話になっております。", "kana": "おせわになっております。", "romaji": "o-sewa ni natte orimasu.", "pos": "expr", "level": "N3", "topic": "work", "ru": "Благодарим за сотрудничество (начало делового письма/звонка).", "en": "Thank you for your continued support."},
  {"id": "phrase_ja_n3_0003", "word": "お手数をおかけします。", "kana": "おてすうをおかけします。", "romaji": "o-tesū o okake shimasu.", "pos": "expr", "level": "N3", "topic": "work", "ru": "Простите за беспокойство (прошу сделать что-то).", "en": "Sorry for the trouble."},
  {"id": "phrase_ja_n3_0004", "word": "恐れ入りますが…", "kana": "おそれいりますが…", "romaji": "osoreirimasu ga…", "pos": "expr", "level": "N3", "topic": "work", "ru": "Извините, пожалуйста, но… (очень вежливо)", "en": "Excuse me, but…"},
  {"id": "phrase_ja_n3_0005", "word": "かしこまりました。", "kana": "かしこまりました。", "romaji": "kashikomarimashita.", "pos": "expr", "level": "N3", "topic": "work", "ru": "Понял(а), будет сделано.", "en": "Certainly."},
  {"id": "phrase_ja_n3_0006", "word": "承知しました。", "kana": "しょうちしました。", "romaji": "shōchi shimashita.", "pos": "expr", "level": "N3", "topic": "work", "ru": "Принято, понял.", "en": "Understood."},
  {"id": "phrase_ja_n3_0007", "word": "少々お待ちください。", "kana": "しょうしょうおまちください。", "romaji": "shōshō o-machi kudasai.", "pos": "expr", "level": "N3", "topic": "work", "ru": "Подождите немного, пожалуйста.", "en": "One moment, please."},
  {"id": "phrase_ja_n3_0008", "word": "お先にどうぞ。", "kana": "おさきにどうぞ。", "romaji": "o-saki ni dōzo.", "pos": "expr", "level": "N3", "topic": "greetings", "ru": "Проходите первым.", "en": "After you."},
  {"id": "phrase_ja_n3_0009", "word": "気にしないでください。", "kana": "きにしないでください。", "romaji": "ki ni shinaide kudasai.", "pos": "expr", "level": "N3", "topic": "greetings", "ru": "Не обращайте внимания.", "en": "Don't worry about it."},
  {"id": "phrase_ja_n3_0010", "word": "仕方がない。", "kana": "しかたがない。", "romaji": "shikata ga nai.", "pos": "expr", "level": "N3", "topic": "qualities", "ru": "Ничего не поделаешь.", "en": "It can't be helped."},
  {"id": "phrase_ja_n3_0011", "word": "それもそうですね。", "kana": "それもそうですね。", "romaji": "sore mo sō desu ne.", "pos": "expr", "level": "N3", "topic": "greetings", "ru": "И то верно.", "en": "That's true too."},
  {"id": "phrase_ja_n3_0012", "word": "言われてみれば…", "kana": "いわれてみれば…", "romaji": "iwarete mireba…", "pos": "expr", "level": "N3", "topic": "greetings", "ru": "Если подумать… (теперь, когда вы сказали)", "en": "Now that you mention it…"},
  {"id": "phrase_ja_n3_0013", "word": "せっかくですから。", "kana": "せっかくですから。", "romaji": "sekkaku desu kara.", "pos": "expr", "level": "N3", "topic": "greetings", "ru": "Раз уж такой случай.", "en": "Since we have the chance."},
  {"id": "phrase_ja_n3_0014", "word": "どうしようもない。", "kana": "どうしようもない。", "romaji": "dō shiyō mo nai.", "pos": "expr", "level": "N3", "topic": "qualities", "ru": "Ничего не поделать; безнадёжно.", "en": "There's nothing to be done."},
  {"id": "phrase_ja_n3_0015", "word": "お言葉に甘えて。", "kana": "おことばにあまえて。", "romaji": "o-kotoba ni amaete.", "pos": "expr", "level": "N3", "topic": "greetings", "ru": "Тогда воспользуюсь вашей добротой.", "en": "Then I'll take you up on your offer."},
  {"id": "phrase_ja_n3_0016", "word": "とんでもないです。", "kana": "とんでもないです。", "romaji": "tondemonai desu.", "pos": "expr", "level": "N3", "topic": "greetings", "ru": "Что вы, не стоит! (на похвалу)", "en": "Not at all!"},
  {"id": "phrase_ja_n3_0017", "word": "おかげさまで。", "kana": "おかげさまで。", "romaji": "okagesama de.", "pos": "expr", "level": "N3", "topic": "greetings", "ru": "Вашими молитвами; всё хорошо, спасибо.", "en": "Thanks to you."},
  {"id": "phrase_ja_n3_0018", "word": "ご無沙汰しております。", "kana": "ごぶさたしております。", "romaji": "go-busata shite orimasu.", "pos": "expr", "level": "N3", "topic": "greetings", "ru": "Давно не выходил на связь (вежливо).", "en": "It's been a long time."},
  {"id": "phrase_ja_n3_0019", "word": "よろしければ…", "kana": "よろしければ…", "romaji": "yoroshikereba…", "pos": "expr", "level": "N3", "topic": "work", "ru": "Если вас не затруднит…", "en": "If you don't mind…"},
  {"id": "phrase_ja_n3_0020", "word": "ご遠慮ください。", "kana": "ごえんりょください。", "romaji": "go-enryo kudasai.", "pos": "expr", "level": "N3", "topic": "city", "ru": "Просьба воздержаться (вывески: не курить и т.п.).", "en": "Please refrain."},
  {"id": "phrase_ja_n3_0021", "word": "足元にご注意ください。", "kana": "あしもとにごちゅういください。", "romaji": "ashimoto ni go-chūi kudasai.", "pos": "expr", "level": "N3", "topic": "transport", "ru": "Осторожно, смотрите под ноги.", "en": "Watch your step."},
  {"id": "phrase_ja_n3_0022", "word": "ドアが閉まります。", "kana": "ドアがしまります。", "romaji": "doa ga shimarimasu.", "pos": "expr", "level": "N3", "topic": "transport", "ru": "Двери закрываются.", "en": "The doors are closing."},
  {"id": "phrase_ja_n3_0023", "word": "次は〇〇です。", "kana": "つぎは〇〇です。", "romaji": "tsugi wa ○○ desu.", "pos": "expr", "level": "N3", "topic": "transport", "ru": "Следующая станция — ○○.", "en": "The next stop is ○○."},
  {"id": "phrase_ja_n3_0024", "word": "ポイントカードはお持ちですか。", "kana": "ポイントカードはおもちですか。", "romaji": "pointo kādo wa o-mochi desu ka.", "pos": "expr", "level": "N3", "topic": "shopping", "ru": "У вас есть бонусная карта?", "en": "Do you have a point card?"},
  {"id": "phrase_ja_n3_0025", "word": "温めますか。", "kana": "あたためますか。", "romaji": "atatamemasu ka.", "pos": "expr", "level": "N3", "topic": "shopping", "ru": "Подогреть? (в магазине)", "en": "Shall I heat it up?"},
  {"id": "phrase_ja_n3_0026", "word": "レシートはご利用ですか。", "kana": "レシートはごりようですか。", "romaji": "reshīto wa go-riyō desu ka.", "pos": "expr", "level": "N3", "topic": "shopping", "ru": "Чек нужен?", "en": "Do you need the receipt?"},
  {"id": "phrase_ja_n3_0027", "word": "体に気をつけてね。", "kana": "からだにきをつけてね。", "romaji": "karada ni ki o tsukete ne.", "pos": "expr", "level": "N3", "topic": "body", "ru": "Береги здоровье.", "en": "Take care of yourself."},
  {"id": "phrase_ja_n3_0028", "word": "具合はどうですか。", "kana": "ぐあいはどうですか。", "romaji": "guai wa dō desu ka.", "pos": "expr", "level": "N3", "topic": "body", "ru": "Как самочувствие?", "en": "How are you feeling?"},
  {"id": "phrase_ja_n3_0029", "word": "それはよかったですね。", "kana": "それはよかったですね。", "romaji": "sore wa yokatta desu ne.", "pos": "expr", "level": "N3", "topic": "greetings", "ru": "Как хорошо! Рад за вас.", "en": "That's great!"},
  {"id": "phrase_ja_n3_0030", "word": "それは大変でしたね。", "kana": "それはたいへんでしたね。", "romaji": "sore wa taihen deshita ne.", "pos": "expr", "level": "N3", "topic": "greetings", "ru": "Нелегко вам пришлось.", "en": "That must have been tough."},
  {"id": "phrase_ja_n3_0031", "word": "お疲れ様です。", "kana": "おつかれさまです。", "romaji": "o-tsukaresama desu.", "pos": "expr", "level": "N3", "topic": "work", "ru": "Спасибо за труд (приветствие коллег).", "en": "Thanks for your hard work."},
  {"id": "phrase_ja_n3_0032", "word": "失礼ですが、お名前は…", "kana": "しつれいですが、おなまえは…", "romaji": "shitsurei desu ga, o-namae wa…", "pos": "expr", "level": "N3", "topic": "people", "ru": "Простите, как вас зовут?", "en": "Excuse me, may I have your name?"},
  {"id": "phrase_ja_n3_0033", "word": "今後ともよろしくお願いいたします。", "kana": "こんごともよろしくおねがいいたします。", "romaji": "kongo tomo yoroshiku onegai itashimasu.", "pos": "expr", "level": "N3", "topic": "work", "ru": "Рассчитываем на дальнейшее сотрудничество.", "en": "We look forward to working with you."},
  {"id": "phrase_ja_n3_0034", "word": "ご検討ください。", "kana": "ごけんとうください。", "romaji": "go-kentō kudasai.", "pos": "expr", "level": "N3", "topic": "work", "ru": "Пожалуйста, рассмотрите.", "en": "Please consider it."},
  {"id": "phrase_ja_n3_0035", "word": "念のため確認させてください。", "kana": "ねんのためかくにんさせてください。", "romaji": "nen no tame kakunin sasete kudasai.", "pos": "expr", "level": "N3", "topic": "work", "ru": "Позвольте на всякий случай уточнить.", "en": "Let me confirm just in case."},
  {"id": "phrase_ja_n3_0036", "word": "よく分かりました。", "kana": "よくわかりました。", "romaji": "yoku wakarimashita.", "pos": "expr", "level": "N3", "topic": "school", "ru": "Всё понятно.", "en": "I understand well."},
  {"id": "phrase_ja_n3_0037", "word": "もう少し詳しく教えてください。", "kana": "もうすこしくわしくおしえてください。", "romaji": "mō sukoshi kuwashiku oshiete kudasai.", "pos": "expr", "level": "N3", "topic": "school", "ru": "Расскажите подробнее, пожалуйста.", "en": "Please tell me in more detail."},
  {"id": "phrase_ja_n3_0038", "word": "おっしゃる通りです。", "kana": "おっしゃるとおりです。", "romaji": "ossharu tōri desu.", "pos": "expr", "level": "N3", "topic": "work", "ru": "Вы совершенно правы.", "en": "You're absolutely right."},
  {"id": "phrase_ja_n3_0039", "word": "申し訳ございません。", "kana": "もうしわけございません。", "romaji": "mōshiwake gozaimasen.", "pos": "expr", "level": "N3", "topic": "work", "ru": "Приношу глубочайшие извинения.", "en": "I sincerely apologize."},
  {"id": "phrase_ja_n3_0040", "word": "ご協力をお願いします。", "kana": "ごきょうりょくをおねがいします。", "romaji": "go-kyōryoku o onegai shimasu.", "pos": "expr", "level": "N3", "topic": "city", "ru": "Просим вашего содействия.", "en": "We ask for your cooperation."}
]
