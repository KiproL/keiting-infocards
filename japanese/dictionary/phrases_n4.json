[
  {"id": "phrase_ja_n4_0001", "word": "お久しぶりです。", "kana": "おひさしぶりです。", "romaji": "o-hisashiburi desu.", "pos": "expr", "level": "N4", "topic": "greetings", "ru": "Давно не виделись.", "en": "Long time no see."},
  {"id": "phrase_ja_n4_0002", "word": "お先に失礼します。", "kana": "おさきにしつれいします。", "romaji": "o-saki ni shitsurei shimasu.", "pos": "expr", "level": "N4", "topic": "work", "ru": "Простите, я пойду первым.", "en": "Excuse me for leaving first.", "note": "Так прощаются с коллегами, уходя с работы раньше них.", "noteEn": "Said to colleagues when leaving work before them."},
  {"id": "phrase_ja_n4_0003", "word": "お邪魔します。", "kana": "おじゃまします。", "romaji": "o-jama shimasu.", "pos": "expr", "level": "N4", "topic": "home", "ru": "Простите за беспокойство (входя в чужой дом).", "en": "Sorry to intrude (entering someone's home)."},
  {"id": "phrase_ja_n4_0004", "word": "どうぞお上がりください。", "kana": "どうぞおあがりください。", "romaji": "dōzo o-agari kudasai.", "pos": "expr", "level": "N4", "topic": "home", "ru": "Проходите, пожалуйста.", "en": "Please come in."},
  {"id": "phrase_ja_n4_0005", "word": "ご遠慮なく。", "kana": "ごえんりょなく。", "romaji": "go-enryo naku.", "pos": "expr", "level": "N4", "topic": "home", "ru": "Не стесняйтесь.", "en": "Please don't hesitate."},
  {"id": "phrase_ja_n4_0006", "word": "お大事に。", "kana": "おだいじに。", "romaji": "o-daiji ni.", "pos": "expr", "level": "N4", "topic": "body", "ru": "Выздоравливайте. Берегите себя.", "en": "Get well soon."},
  {"id": "phrase_ja_n4_0007", "word": "熱があります。", "kana": "ねつがあります。", "romaji": "netsu ga arimasu.", "pos": "expr", "level": "N4", "topic": "body", "ru": "У меня температура.", "en": "I have a fever."},
  {"id": "phrase_ja_n4_0008", "word": "風邪をひきました。", "kana": "かぜをひきました。", "romaji": "kaze o hikimashita.", "pos": "expr", "level": "N4", "topic": "body", "ru": "Я простудился.", "en": "I caught a cold."},
  {"id": "phrase_ja_n4_0009", "word": "病院へ行ったほうがいいですよ。", "kana": "びょういんへいったほうがいいですよ。", "romaji": "byōin e itta hō ga ii desu yo.", "pos": "expr", "level": "N4", "topic": "body", "ru": "Лучше сходить в больницу.", "en": "You'd better go to the hospital."},
  {"id": "phrase_ja_n4_0010", "word": "道に迷いました。", "kana": "みちにまよいました。", "romaji": "michi ni mayoimashita.", "pos": "expr", "level": "N4", "topic": "city", "ru": "Я заблудился.", "en": "I got lost."},
  {"id": "phrase_ja_n4_0011", "word": "地図を書いてもらえませんか。", "kana": "ちずをかいてもらえませんか。", "romaji": "chizu o kaite moraemasen ka.", "pos": "expr", "level": "N4", "topic": "city", "ru": "Не могли бы вы нарисовать карту?", "en": "Could you draw me a map?"},
  {"id": "phrase_ja_n4_0012", "word": "この近くにコンビニはありますか。", "kana": "このちかくにコンビニはありますか。", "romaji": "kono chikaku ni konbini wa arimasu ka.", "pos": "expr", "level": "N4", "topic": "city", "ru": "Здесь поблизости есть магазин?", "en": "Is there a convenience store nearby?"},
  {"id": "phrase_ja_n4_0013", "word": "乗り換えはどこですか。", "kana": "のりかえはどこですか。", "romaji": "norikae wa doko desu ka.", "pos": "expr", "level": "N4", "topic": "transport", "ru": "Где пересадка?", "en": "Where do I transfer?"},
  {"id": "phrase_ja_n4_0014", "word": "終電は何時ですか。", "kana": "しゅうでんはなんじですか。", "romaji": "shūden wa nanji desu ka.", "pos": "expr", "level": "N4", "topic": "transport", "ru": "Во сколько последний поезд?", "en": "What time is the last train?"},
  {"id": "phrase_ja_n4_0015", "word": "次の駅で降ります。", "kana": "つぎのえきでおります。", "romaji": "tsugi no eki de orimasu.", "pos": "expr", "level": "N4", "topic": "transport", "ru": "Выхожу на следующей станции.", "en": "I'm getting off at the next station."},
  {"id": "phrase_ja_n4_0016", "word": "予約したいんですが。", "kana": "よやくしたいんですが。", "romaji": "yoyaku shitai n desu ga.", "pos": "expr", "level": "N4", "topic": "shopping", "ru": "Я хотел бы забронировать.", "en": "I'd like to make a reservation."},
  {"id": "phrase_ja_n4_0017", "word": "試着してもいいですか。", "kana": "しちゃくしてもいいですか。", "romaji": "shichaku shite mo ii desu ka.", "pos": "expr", "level": "N4", "topic": "clothes", "ru": "Можно примерить?", "en": "May I try it on?"},
  {"id": "phrase_ja_n4_0018", "word": "もう少し安いのはありますか。", "kana": "もうすこしやすいのはありますか。", "romaji": "mō sukoshi yasui no wa arimasu ka.", "pos": "expr", "level": "N4", "topic": "shopping", "ru": "Есть что-нибудь подешевле?", "en": "Do you have something cheaper?"},
  {"id": "phrase_ja_n4_0019", "word": "別々にお願いします。", "kana": "べつべつにおねがいします。", "romaji": "betsubetsu ni onegai shimasu.", "pos": "expr", "level": "N4", "topic": "food", "ru": "Посчитайте отдельно, пожалуйста.", "en": "Separate bills, please."},
  {"id": "phrase_ja_n4_0020", "word": "持ち帰りでお願いします。", "kana": "もちかえりでおねがいします。", "romaji": "mochikaeri de onegai shimasu.", "pos": "expr", "level": "N4", "topic": "food", "ru": "С собой, пожалуйста.", "en": "To go, please."},
  {"id": "phrase_ja_n4_0021", "word": "アレルギーがあります。", "kana": "アレルギーがあります。", "romaji": "arerugī ga arimasu.", "pos": "expr", "level": "N4", "topic": "food", "ru": "У меня аллергия.", "en": "I have an allergy."},
  {"id": "phrase_ja_n4_0022", "word": "どうしたんですか。", "kana": "どうしたんですか。", "romaji": "dō shita n desu ka.", "pos": "expr", "level": "N4", "topic": "questions", "ru": "Что случилось?", "en": "What happened?"},
  {"id": "phrase_ja_n4_0023", "word": "どういう意味ですか。", "kana": "どういういみですか。", "romaji": "dō iu imi desu ka.", "pos": "expr", "level": "N4", "topic": "school", "ru": "Что это значит?", "en": "What does it mean?"},
  {"id": "phrase_ja_n4_0024", "word": "漢字で書いてください。", "kana": "かんじでかいてください。", "romaji": "kanji de kaite kudasai.", "pos": "expr", "level": "N4", "topic": "school", "ru": "Напишите, пожалуйста, иероглифами.", "en": "Please write it in kanji."},
  {"id": "phrase_ja_n4_0025", "word": "日本語を勉強しています。", "kana": "にほんごをべんきょうしています。", "romaji": "nihongo o benkyō shite imasu.", "pos": "expr", "level": "N4", "topic": "school", "ru": "Я изучаю японский.", "en": "I'm studying Japanese."},
  {"id": "phrase_ja_n4_0026", "word": "日本へ行ったことがあります。", "kana": "にほんへいったことがあります。", "romaji": "nihon e itta koto ga arimasu.", "pos": "expr", "level": "N4", "topic": "hobby", "ru": "Я бывал в Японии.", "en": "I have been to Japan."},
  {"id": "phrase_ja_n4_0027", "word": "週末は何をしましたか。", "kana": "しゅうまつはなにをしましたか。", "romaji": "shūmatsu wa nani o shimashita ka.", "pos": "expr", "level": "N4", "topic": "hobby", "ru": "Что делал на выходных?", "en": "What did you do on the weekend?"},
  {"id": "phrase_ja_n4_0028", "word": "映画を見に行きませんか。", "kana": "えいがをみにいきませんか。", "romaji": "eiga o mi ni ikimasen ka.", "pos": "expr", "level": "N4", "topic": "hobby", "ru": "Не сходить ли нам в кино?", "en": "Shall we go see a movie?"},
  {"id": "phrase_ja_n4_0029", "word": "残念ですが、都合が悪いです。", "kana": "ざんねんですが、つごうがわるいです。", "romaji": "zannen desu ga, tsugō ga warui desu.", "pos": "expr", "level": "N4", "topic": "hobby", "ru": "К сожалению, мне неудобно.", "en": "Unfortunately, it doesn't suit me."},
  {"id": "phrase_ja_n4_0030", "word": "また今度お願いします。", "kana": "またこんどおねがいします。", "romaji": "mata kondo onegai shimasu.", "pos": "expr", "level": "N4", "topic": "hobby", "ru": "Давайте в другой раз.", "en": "Maybe next time."},
  {"id": "phrase_ja_n4_0031", "word": "遅れてすみません。", "kana": "おくれてすみません。", "romaji": "okurete sumimasen.", "pos": "expr", "level": "N4", "topic": "time", "ru": "Извините за опоздание.", "en": "Sorry I'm late."},
  {"id": "phrase_ja_n4_0032", "word": "間に合いますか。", "kana": "まにあいますか。", "romaji": "maniaimasu ka.", "pos": "expr", "level": "N4", "topic": "time", "ru": "Успеем?", "en": "Will we make it in time?"},
  {"id": "phrase_ja_n4_0033", "word": "時間がありません。", "kana": "じかんがありません。", "romaji": "jikan ga arimasen.", "pos": "expr", "level": "N4", "topic": "time", "ru": "Нет времени.", "en": "There's no time."},
  {"id": "phrase_ja_n4_0034", "word": "手伝いましょうか。", "kana": "てつだいましょうか。", "romaji": "tetsudaimashō ka.", "pos": "expr", "level": "N4", "topic": "actions", "ru": "Вам помочь?", "en": "Shall I help you?"},
  {"id": "phrase_ja_n4_0035", "word": "ちょっとお願いがあるんですが。", "kana": "ちょっとおねがいがあるんですが。", "romaji": "chotto onegai ga aru n desu ga.", "pos": "expr", "level": "N4", "topic": "actions", "ru": "У меня к вам небольшая просьба.", "en": "I have a small favor to ask."},
  {"id": "phrase_ja_n4_0036", "word": "ぜひ。", "kana": "ぜひ。", "romaji": "zehi.", "pos": "expr", "level": "N4", "topic": "greetings", "ru": "Обязательно! С удовольствием.", "en": "By all means!"},
  {"id": "phrase_ja_n4_0037", "word": "そうですね。", "kana": "そうですね。", "romaji": "sō desu ne.", "pos": "expr", "level": "N4", "topic": "greetings", "ru": "Да, верно. Хм, дайте подумать.", "en": "That's right. / Let me see."},
  {"id": "phrase_ja_n4_0038", "word": "なるほど。", "kana": "なるほど。", "romaji": "naruhodo.", "pos": "expr", "level": "N4", "topic": "greetings", "ru": "Понятно. Вот оно что.", "en": "I see."},
  {"id": "phrase_ja_n4_0039", "word": "本当ですか。", "kana": "ほんとうですか。", "romaji": "hontō desu ka.", "pos": "expr", "level": "N4", "topic": "greetings", "ru": "Правда?", "en": "Really?"},
  {"id": "phrase_ja_n4_0040", "word": "さすがですね。", "kana": "さすがですね。", "romaji": "sasuga desu ne.", "pos": "expr", "level": "N4", "topic": "qualities", "ru": "Как и следовало ожидать от вас!", "en": "Just as expected of you!"},
  {"id": "phrase_ja_n4_0041", "word": "頑張ってください。", "kana": "がんばってください。", "romaji": "ganbatte kudasai.", "pos": "expr", "level": "N4", "topic": "greetings", "ru": "Удачи! Постарайтесь!", "en": "Good luck! Do your best!"},
  {"id": "phrase_ja_n4_0042", "word": "無理しないでください。", "kana": "むりしないでください。", "romaji": "muri shinaide kudasai.", "pos": "expr", "level": "N4", "topic": "body", "ru": "Не перенапрягайтесь.", "en": "Don't push yourself too hard."},
  {"id": "phrase_ja_n4_0043", "word": "心配しないでください。", "kana": "しんぱいしないでください。", "romaji": "shinpai shinaide kudasai.", "pos": "expr", "level": "N4", "topic": "greetings", "ru": "Не волнуйтесь.", "en": "Don't worry."},
  {"id": "phrase_ja_n4_0044", "word": "どちらでもいいです。", "kana": "どちらでもいいです。", "romaji": "dochira demo ii desu.", "pos": "expr", "level": "N4", "topic": "questions", "ru": "Мне всё равно (любой вариант).", "en": "Either is fine."},
  {"id": "phrase_ja_n4_0045", "word": "明日は雨が降るそうです。", "kana": "あしたはあめがふるそうです。", "romaji": "ashita wa ame ga furu sō desu.", "pos": "expr", "level": "N4", "topic": "nature", "ru": "Говорят, завтра будет дождь.", "en": "I hear it will rain tomorrow."},
  {"id": "phrase_ja_n4_0046", "word": "傘を持っていったほうがいいです。", "kana": "かさをもっていったほうがいいです。", "romaji": "kasa o motte itta hō ga ii desu.", "pos": "expr", "level": "N4", "topic": "nature", "ru": "Лучше взять зонт.", "en": "You'd better take an umbrella."},
  {"id": "phrase_ja_n4_0047", "word": "引っ越しました。", "kana": "ひっこしました。", "romaji": "hikkoshimashita.", "pos": "expr", "level": "N4", "topic": "home", "ru": "Я переехал.", "en": "I moved (house)."},
