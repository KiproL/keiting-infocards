  {"id": "phrase_ja_n4_0049", "word": "よろしくお伝えください。", "kana": "よろしくおつたえください。", "romaji": "yoroshiku o-tsutae kudasai.", "pos": "expr", "level": "N4", "topic": "greetings", "ru": "Передавайте привет.", "en": "Please give my regards."},
