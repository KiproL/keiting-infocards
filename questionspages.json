        "highlights": [
          { "text": "пять типов вопросов", "color": "term",    "style": "bold_underline" },
          { "text": "Question Tags",        "color": "info",    "style": "bold" },
          { "text": "утверждения",          "color": "example", "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Пять типов",
          "borderColor": "info",
          "table": {
            "headers": ["Тип", "Пример", "Перевод"],
            "headerColors": ["info", "example", "term"],
            "rows": [
