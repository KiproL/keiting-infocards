              { "cells": ["Специальный",    "Where do you live?",        "Где ты живёшь?"] },
              { "cells": ["К подлежащему",  "Who called you?",            "Кто тебе позвонил?"] },
              { "cells": ["Альтернативный", "Tea or coffee?",             "Чай или кофе?"] },
