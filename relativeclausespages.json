            {
              "wrong": "The man which called…",
              "right": "The man who called…"
            },
            {
              "wrong": "The book who I read…",
              "right": "The book which / that I read…"
            },
            {
              "wrong": "My mother, that is a doctor, …",
              "right": "My mother, who is a doctor, …"
            },
            {
              "wrong": "The film that I saw it was good.",
              "right": "The film that I saw was good."
            },
            {
              "wrong": "The city where I was born in…",
              "right": "The city where I was born… / The city I was born in…"
            },
            {
              "wrong": "The boy who's dog ran away…",
              "right": "The boy whose dog ran away…"
