            ],
            "borderColor": "good"
          }
        }
      ]
    },

    {
      "label": "Частые ошибки: There is / There are",
      "intro": {
        "text": "Четыре самые частые ошибки в конструкции There is / There are.",
        "highlights": [
          { "text": "Четыре самые частые", "color": "bad", "style": "bold_underline" }
        ]
      },
      "sections": [
        {
          "title": "Слева — нельзя, справа — правильно",
          "borderColor": "bad",
          "errors": [
            { "wrong": "It is a book on the table.",  "right": "There is a book on the table." },
            { "wrong": "There is two cats.",           "right": "There are two cats." },
            { "wrong": "There have a lot of people.",  "right": "There are a lot of people." },
            { "wrong": "Do there is a bank?",          "right": "Is there a bank?" }
          ]
        },
        {
          "title": "Совет",
          "borderColor": "good",
          "callout": {
            "type": "tip",
            "title": "Простой тест",
            "text": "Если по-русски предложение начинается с «есть / находится / имеется» — в английском почти всегда There is / There are."
          }
