              ],
              "accentColor": "bad", "drill": {"slots": ["There isn't", "a / any", "предмет"], "decoys": ["no", "some"], "examples": [{"en": "There isn't a bank near here.", "ru": "Здесь рядом нет банка.", "parts": [["There isn't", "There isn't"], ["a", "a / any"], ["bank", "предмет"], ["near here.", ""]]}, {"en": "There isn't any sugar.", "ru": "Сахара нет.", "parts": [["There isn't", "There isn't"], ["any", "a / any"], ["sugar.", "предмет"]]}, {"en": "There isn't a lift here.", "ru": "Здесь нет лифта.", "parts": [["There isn't", "There isn't"], ["a", "a / any"], ["lift", "предмет"], ["here.", ""]]}]}
            }
          ],
          "examples": [
            { "en": "There is no milk in the fridge.",       "ru": "В холодильнике нет молока." },
            { "en": "There isn't any milk in the fridge.",    "ru": "В холодильнике нет молока." },
            { "en": "There are no chairs in the room.",       "ru": "В комнате нет стульев." },
            { "en": "There aren't any chairs in the room.",   "ru": "В комнате нет стульев." }
          ]
        },
        {
          "title": "Вопрос",
          "borderColor": "info",
          "formulaCard": {
