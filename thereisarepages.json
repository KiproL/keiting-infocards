{
  "tenseName": "There is / There are",
  "route": "cards_thereisare",
  "slides": [
    {
      "label": "There is / are: что где есть",
      "intro": {
        "text": "Конструкция There is / There are говорит, что что-то где-то есть. В русском мы часто говорим «На столе книга», а в английском обязательно нужен There is.",
        "highlights": [
          { "text": "There is / There are", "color": "term",    "style": "bold_underline" },
          { "text": "что-то где-то есть",    "color": "info",    "style": "bold" },
          { "text": "обязательно",           "color": "bad",     "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Формулы",
          "borderColor": "term",
          "formulas": [
            {
              "parts": [
                { "text": "There is", "color": "info" },
                { "text": "+",        "color": "muted" },
                { "text": "один предмет", "color": "example" },
                { "text": "(ед. ч.)",  "color": "term" }
              ],
              "accentColor": "info"
            },
            {
              "parts": [
                { "text": "There are", "color": "good" },
                { "text": "+",         "color": "muted" },
                { "text": "много предметов", "color": "example" },
                { "text": "(мн. ч.)",  "color": "term" }
              ],
              "accentColor": "good"
            }
          ]
        },
        {
          "title": "Сравнение",
          "borderColor": "info",
          "table": {
            "headers": ["Форма", "Когда", "Пример"],
            "headerColors": ["info", "example", "term"],
            "rows": [
              { "cells": ["There is",  "один предмет",   "There is a book on the table."] },
              { "cells": ["There are", "два и больше",   "There are two books on the table."] },
              { "cells": ["There is",  "неисчисляемое",  "There is some milk in the fridge."] }
            ],
            "borderColor": "info"
          }
        },
        {
          "title": "Живые примеры",
          "borderColor": "good",
          "examples": [
            { "en": "There is a cat in the garden.",       "ru": "В саду кошка." },
            { "en": "There are many people at the party.",  "ru": "На вечеринке много людей." },
            { "en": "There is some water in the glass.",    "ru": "В стакане есть вода." },
            { "en": "There is a problem with my phone.",    "ru": "С моим телефоном проблема." }
          ]
        },
        {
          "title": "Мысль напоследок",
          "borderColor": "accent2",
          "quote": {
            "text": "There is — это не «там». Это просто «есть».",
            "author": "правило большого пальца",
            "accentColor": "accent2"
          }
        }
      ]
    },

    {
