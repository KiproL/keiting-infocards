            ],
            "accentColor": "info", "drill": {"slots": ["Is / Are", "there", "предмет?"], "decoys": ["it", "Do"], "examples": [{"en": "Is there a bank near here?", "ru": "Здесь рядом есть банк?", "parts": [["Is", "Is / Are"], ["there", "there"], ["a bank", "предмет?"], ["near here?", ""]]}, {"en": "Are there any eggs?", "ru": "Яйца есть?", "parts": [["Are", "Is / Are"], ["there", "there"], ["any eggs?", "предмет?"]]}, {"en": "Is there a lift?", "ru": "Здесь есть лифт?", "parts": [["Is", "Is / Are"], ["there", "there"], ["a lift?", "предмет?"]]}]}
          },
