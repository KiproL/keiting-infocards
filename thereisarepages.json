              ],
              "accentColor": "bad", "drill": {"slots": ["There is", "no", "предмет"], "decoys": ["not", "any"], "examples": [{"en": "There is no milk in the fridge.", "ru": "В холодильнике нет молока.", "parts": [["There is", "There is"], ["no", "no"], ["milk", "предмет"], ["in the fridge.", ""]]}, {"en": "There is no time to lose.", "ru": "Нельзя терять время.", "parts": [["There is", "There is"], ["no", "no"], ["time", "предмет"], ["to lose.", ""]]}, {"en": "There is no lift in this building.", "ru": "В этом здании нет лифта.", "parts": [["There is", "There is"], ["no", "no"], ["lift", "предмет"], ["in this building.", ""]]}]}
            },
