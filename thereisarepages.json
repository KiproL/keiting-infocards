        "highlights": [
          { "text": "без do / does", "color": "bad",  "style": "bold_underline" },
          { "text": "not",            "color": "info", "style": "bold" },
          { "text": "переставляем",   "color": "term", "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Отрицание",
          "borderColor": "bad",
          "formulas": [
            {
              "parts": [
