            "headerColors": [
              "info",
              "example",
              "term"
            ],
            "rows": [
              {
                "cells": [
                  "Personal",
                  "I, you, he, she",
                  "я, ты, он, она"
                ]
              },
              {
                "cells": [
                  "Possessive",
                  "my, your, his",
                  "мой, твой, его"
                ]
              },
              {
                "cells": [
                  "Reflexive",
                  "myself, yourself",
                  "себя, сам"
                ]
              },
              {
                "cells": [
                  "Demonstrative",
                  "this, that, these",
                  "этот, тот, эти"
                ]
              },
              {
                "cells": [
                  "Interrogative",
                  "who, what, which",
                  "кто, что, который"
                ]
              },
              {
                "cells": [
                  "Relative",
                  "who, which, that",
                  "который"
                ]
              }
            ],
            "borderColor": "info"
          }
        },
        {
          "title": "Мысль напоследок",
          "borderColor": "accent2",
          "quote": {
            "text": "Местоимение — это слово-заменитель. Оно работает, пока понятно, что именно заменяет.",
