              "example": "It's raining. It's 5 pm."
            }
          ]
        },
        {
          "title": "Живые примеры",
          "borderColor": "good",
          "examples": [
            {
              "en": "She called me yesterday.",
              "ru": "Она позвонила мне вчера."
            },
            {
              "en": "Give it to him.",
              "ru": "Отдай это ему."
            },
            {
              "en": "We will help you.",
              "ru": "Мы поможем тебе."
            },
            {
              "en": "They invited us to dinner.",
              "ru": "Они пригласили нас на ужин."
            }
