    {
      "label": "Какие бывают местоимения",
      "intro": {
        "text": "Местоимения заменяют существительные, чтобы не повторять их: Anna → she. В английском шесть основных видов, и у каждого свои правила.",
        "highlights": [
          {
            "text": "заменяют существительные",
            "color": "term",
            "style": "bold"
          },
          {
            "text": "не повторять",
            "color": "info",
            "style": "bold"
          },
          {
            "text": "шесть",
            "color": "example",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Шесть типов",
          "borderColor": "info",
          "table": {
            "headers": [
              "Тип",
              "Пример",
              "Перевод"
            ],
            "headerColors": [
              "info",
              "example",
              "term"
            ],
            "rows": [
              {
                "cells": [
                  "Personal",
                  "I, you, he, she",
                  "я, ты, он, она"
                ]
              },
              {
                "cells": [
                  "Possessive",
                  "my, your, his",
                  "мой, твой, его"
                ]
              },
              {
                "cells": [
                  "Reflexive",
                  "myself, yourself",
                  "себя, сам"
                ]
              },
              {
                "cells": [
                  "Demonstrative",
                  "this, that, these",
                  "этот, тот, эти"
                ]
              },
              {
                "cells": [
                  "Interrogative",
                  "who, what, which",
                  "кто, что, который"
                ]
              },
              {
                "cells": [
                  "Relative",
                  "who, which, that",
                  "который"
                ]
              }
            ],
            "borderColor": "info"
          }
        },
        {
          "title": "Местоимение заменяет слово",
          "borderColor": "good",
          "examples": [
            {
              "en": "Anna is my friend. She lives in Kazan.",
              "ru": "Анна — моя подруга. Она живёт в Казани."
