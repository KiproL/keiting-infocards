        ]
      },
      "sections": [
        {
          "title": "Правила",
          "borderColor": "info",
          "rules": [
            {
              "name": "Большинство",
              "suffix": "+ ing",
              "example": "work → working, read → reading"
            },
            {
              "name": "Немая -e",
              "suffix": "e убирается + ing",
              "example": "write → writing, make → making"
            },
            {
              "name": "Гласная + согл. в конце",
              "suffix": "удвоение + ing",
              "example": "run → running, sit → sitting"
            },
            {
              "name": "Глаголы на -ie",
              "suffix": "ie → y + ing",
              "example": "lie → lying, die → dying"
            }
          ]
        },
        {
          "title": "Что не меняется",
          "borderColor": "term",
          "callout": {
            "type": "info",
            "title": "been фиксировано",
            "text": "После have / has всегда been. Затем — глагол с -ing. Порядок: have + been + V-ing или has + been + V-ing."
          }
        },
        {
          "title": "Живые примеры",
          "borderColor": "good",
          "examples": [
