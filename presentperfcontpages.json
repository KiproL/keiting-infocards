{
  "tenseName": "Present Perfect Continuous",
  "route": "cards_presentperfcont",
  "slides": [
    {
      "label": "Что это",
      "intro": {
        "text": "Present Perfect Continuous описывает действие, которое началось в прошлом и продолжается до сих пор (или только что закончилось). Важна длительность.",
        "highlights": [
          { "text": "Present Perfect Continuous", "color": "term",    "style": "bold_underline" },
          { "text": "продолжается до сих пор",     "color": "info",    "style": "bold" },
          { "text": "длительность",                 "color": "example", "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Формула",
          "borderColor": "term",
          "formulaCard": {
            "parts": [
              { "text": "S",                "color": "info" },
              { "text": "+",                "color": "muted" },
              { "text": "have / has been",  "color": "term" },
              { "text": "+",                "color": "muted" },
              { "text": "V-ing",            "color": "example" }
            ],
            "accentColor": "term"
          }
        },
        {
          "title": "Кто какой использует",
          "borderColor": "info",
          "table": {
            "headers": ["Форма", "Кому", "Пример"],
            "headerColors": ["info", "example", "term"],
            "rows": [
              { "cells": ["have been",  "I / you / we / they",  "I have been waiting."] },
              { "cells": ["has been",   "he / she / it",          "She has been working."] }
            ],
            "borderColor": "info"
          }
        },
        {
          "title": "Ключевые маркеры",
          "borderColor": "good",
          "verbGrid": {
            "accentColor": "example",
            "verbs": ["for", "since", "how long", "recently", "lately", "all day", "all week", "just"]
          }
        },
        {
          "title": "Живые примеры",
          "borderColor": "good",
          "examples": [
            { "en": "I have been waiting for an hour.",       "ru": "Я жду уже час." },
            { "en": "She has been working all day.",            "ru": "Она работает весь день." },
            { "en": "How long have you been living here?",      "ru": "Как долго ты здесь живёшь?" },
            { "en": "It has been raining all day.",              "ru": "Весь день идёт дождь." }
          ]
        },
        {
          "title": "Мысль напоследок",
          "borderColor": "accent2",
          "quote": {
            "text": "Present Perfect Continuous — про то, как долго уже длится.",
            "author": "правило большого пальца",
            "accentColor": "accent2"
          }
        }
      ]
    },

    {
      "label": "Три формы",
      "intro": {
        "text": "Have / has been не меняется в зависимости от глагола. Одна конструкция для всех глаголов.",
        "highlights": [
          { "text": "have / has been", "color": "term",    "style": "bold_underline" },
          { "text": "не меняется",       "color": "info",    "style": "bold" },
          { "text": "V-ing",              "color": "example", "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Утверждение",
          "borderColor": "good",
          "formulaCard": {
            "parts": [
              { "text": "I / You / We / They", "color": "info" },
              { "text": "+ have been + V-ing",  "color": "example" },
              { "text": "·",                     "color": "muted" },
              { "text": "He / She / It",         "color": "info" },
              { "text": "+ has been + V-ing",    "color": "term" }
            ],
            "accentColor": "good"
          },
          "examples": [
            { "en": "I have been waiting for an hour.",  "ru": "Я жду уже час." },
            { "en": "She has been working all day.",       "ru": "Она работает весь день." }
          ]
        },
        {
          "title": "Отрицание",
          "borderColor": "bad",
          "formulaCard": {
            "parts": [
              { "text": "have / has", "color": "info" },
              { "text": "+",          "color": "muted" },
              { "text": "not been",   "color": "bad" },
              { "text": "+",          "color": "muted" },
              { "text": "V-ing",      "color": "example" }
            ],
            "accentColor": "bad"
          },
          "examples": [
            { "en": "She hasn't been sleeping well.",   "ru": "Она плохо спит последнее время." },
            { "en": "They haven't been talking to each other.", "ru": "Они не разговаривают друг с другом." }
          ]
        },
        {
          "title": "Вопрос",
          "borderColor": "info",
          "formulaCard": {
            "parts": [
              { "text": "Have / Has", "color": "info" },
              { "text": "+",          "color": "muted" },
              { "text": "S",          "color": "example" },
              { "text": "+",          "color": "muted" },
              { "text": "been + V-ing?", "color": "term" }
            ],
            "accentColor": "info"
          },
          "examples": [
            { "en": "Have you been studying English long?",  "ru": "Ты давно учишь английский?" },
            { "en": "How long has she been working here?",     "ru": "Как долго она здесь работает?" }
          ]
        },
        {
          "title": "Сокращения",
          "borderColor": "term",
          "table": {
            "headers": ["Полная форма", "Сокращение"],
            "headerColors": ["info", "example"],
            "rows": [
              { "cells": ["I have been",     "I've been"] },
              { "cells": ["you have been",   "you've been"] },
              { "cells": ["he has been",      "he's been"] },
              { "cells": ["have not been",    "haven't been"] },
              { "cells": ["has not been",     "hasn't been"] }
            ],
            "borderColor": "term"
          }
        }
      ]
    },

    {
      "label": "Слова-маркеры",
      "intro": {
        "text": "Эти слова подчёркивают длительность действия — как долго оно продолжается или продолжалось.",
        "highlights": [
          { "text": "Слова-маркеры", "color": "term",    "style": "bold_underline" },
          { "text": "длительность",   "color": "info",    "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Главные маркеры",
          "borderColor": "info",
          "table": {
            "headers": ["Маркер", "Перевод", "Пример"],
            "headerColors": ["info", "example", "term"],
            "rows": [
              { "cells": ["for",             "в течение",                 "I have been learning English for three years."] },
              { "cells": ["since",            "с (момента)",                "She has been working here since 2019."] },
              { "cells": ["how long",         "как долго",                  "How long have you been waiting?"] },
              { "cells": ["recently / lately","недавно / в последнее время","I have been feeling tired lately."] },
              { "cells": ["all day / all week","весь день / всю неделю",    "It has been raining all day."] },
              { "cells": ["just",              "только что",                 "I have just been talking to her."] }
            ],
            "borderColor": "info"
          }
        },
        {
          "title": "For vs Since",
          "borderColor": "term",
          "rules": [
            { "name": "for",   "suffix": "период (сколько)",         "example": "I have been waiting for two hours." },
            { "name": "since", "suffix": "точка начала (с когда)",   "example": "She has been working since 2019." }
          ]
        },
        {
          "title": "Живые примеры",
          "borderColor": "good",
          "examples": [
            { "en": "I have been learning English for three years.",  "ru": "Я учу английский уже три года." },
            { "en": "She has been working here since 2019.",           "ru": "Она работает здесь с 2019 года." },
            { "en": "It has been raining all day.",                     "ru": "Весь день идёт дождь." },
            { "en": "I have been feeling tired lately.",                "ru": "Я в последнее время чувствую усталость." }
          ]
        }
      ]
    },

    {
      "label": "Окончание -ing",
      "intro": {
        "text": "После been глагол всегда с окончанием -ing. Написание зависит от последних букв глагола.",
        "highlights": [
          { "text": "-ing",   "color": "term",    "style": "bold_underline" },
          { "text": "been",    "color": "info",    "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Правила",
          "borderColor": "info",
          "rules": [
            { "name": "Большинство",            "suffix": "+ ing",              "example": "work → working, read → reading" },
            { "name": "Немая -e",                "suffix": "e убирается + ing",   "example": "write → writing, make → making" },
            { "name": "Гласная + согл. в конце", "suffix": "удвоение + ing",       "example": "run → running, sit → sitting" },
            { "name": "Глаголы на -ie",           "suffix": "ie → y + ing",         "example": "lie → lying, die → dying" }
          ]
        },
        {
          "title": "Что не меняется",
          "borderColor": "term",
          "callout": {
            "type": "info",
            "title": "been фиксировано",
            "text": "После have / has всегда been. Затем — глагол с -ing. Порядок: have + been + V-ing или has + been + V-ing."
          }
        },
        {
          "title": "Живые примеры",
          "borderColor": "good",
          "examples": [
            { "en": "I have been writing this essay for two hours.",  "ru": "Я пишу это эссе уже два часа." },
            { "en": "They have been running since morning.",            "ru": "Они бегают с самого утра." },
            { "en": "She has been reading all evening.",                 "ru": "Она читает весь вечер." }
          ]
        }
      ]
    },

    {
      "label": "Perfect Continuous vs Perfect",
      "intro": {
        "text": "Оба времени связывают прошлое с настоящим, но Present Perfect Continuous делает акцент на процессе, а Present Perfect — на результате.",
        "highlights": [
          { "text": "Perfect Continuous", "color": "info",    "style": "bold" },
          { "text": "Perfect",             "color": "bad",     "style": "bold" },
          { "text": "процессе",             "color": "example", "style": "bold_underline" },
          { "text": "результате",           "color": "term",    "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Сравнение",
          "borderColor": "info",
          "table": {
            "headers": ["Время", "Акцент", "Форма"],
            "headerColors": ["info", "example", "term"],
            "rows": [
              { "cells": ["Perfect Continuous", "процесс, длительность", "have / has been + V-ing"] },
              { "cells": ["Perfect",             "результат, факт",       "have / has + V3"] }
            ],
            "borderColor": "info"
          }
        },
        {
          "title": "Примеры",
          "borderColor": "good",
          "examples": [
            { "en": "I have been reading this book.",     "ru": "Я читаю эту книгу. (процесс)" },
            { "en": "I have read this book.",              "ru": "Я прочитал эту книгу. (результат)" }
          ]
        },
        {
          "title": "Сравнение с объёмом",
          "borderColor": "term",
          "examples": [
            { "en": "She has been writing emails all morning.",  "ru": "Она пишет письма всё утро. (процесс)" },
            { "en": "She has written five emails.",                "ru": "Она написала пять писем. (результат)" }
          ]
        },
        {
          "title": "Совет",
          "borderColor": "good",
          "callout": {
            "type": "tip",
            "title": "Как различить",
            "text": "Если отвечаешь на вопрос «как долго?» — Perfect Continuous. Если «сколько сделано?» — Perfect."
          },
          "quote": {
            "text": "Perfect считает, Perfect Continuous измеряет.",
            "author": "правило большого пальца",
            "accentColor": "accent2"
          }
        }
      ]
    },

    {
      "label": "Ошибки",
      "intro": {
        "text": "Семь самых частых ошибок в Present Perfect Continuous.",
        "highlights": [
          { "text": "Семь самых частых", "color": "bad", "style": "bold_underline" }
        ]
      },
      "sections": [
        {
          "title": "Слева — нельзя, справа — правильно",
          "borderColor": "bad",
          "errors": [
            { "wrong": "I have been wait for an hour.",      "right": "I have been waiting for an hour." },
            { "wrong": "She has been work all day.",           "right": "She has been working all day." },
            { "wrong": "I have been waiting since two hours.", "right": "I have been waiting for two hours." },
            { "wrong": "They has been running.",                "right": "They have been running." },
            { "wrong": "He have been working.",                  "right": "He has been working." },
            { "wrong": "I have been wrote this essay.",          "right": "I have been writing this essay." },
            { "wrong": "I have been working since 2015. (если с 2015 верно)", "right": "I have been working since 2015." }
          ]
        },
        {
          "title": "Совет",
          "borderColor": "good",
          "callout": {
            "type": "tip",
            "title": "Правило большого пальца",
            "text": "Have / has + been + глагол с -ing. been не меняется, V-ing не меняется. После for — период, после since — точка начала."
          },
          "quote": {
            "text": "Три части — have / has, been, V-ing. Убери одну — рассыпется всё.",
            "author": "заметка на полях",
            "accentColor": "accent2"
          }
        }
      ]
    }
  ]
}
