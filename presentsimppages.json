      "sections": [
        {
          "title": "Слева — нельзя, справа — правильно",
          "borderColor": "bad",
          "errors": [
            {
              "wrong": "He play football.",
              "right": "He plays football. (he → глагол с -s)"
            },
            {
              "wrong": "She don't like tea.",
              "right": "She doesn't like tea. (she → does)"
            },
            {
              "wrong": "Does he plays football?",
              "right": "Does he play football? (-s уже в does)"
            },
            {
              "wrong": "He doesn't plays football.",
              "right": "He doesn't play football. (-s уже в doesn't)"
            },
            {
              "wrong": "I am play football.",
              "right": "I play football. (am с действием не нужен)"
            },
            {
              "wrong": "He have a car.",
              "right": "He has a car. (have → has)"
            },
            {
              "wrong": "She study English.",
              "right": "She studies English. (y → ies)"
            }
          ]
        },
        {
          "title": "Совет",
          "borderColor": "good",
          "callout": {
            "type": "tip",
            "title": "Правило большого пальца",
            "text": "Если есть does — глагол без -s. Если нет does и подлежащее he/she/it — глагол с -s. Никогда не бывает -s и does одновременно."
          },
          "quote": {
            "text": "Простое время — простое правило: -s с he/she/it, но не рядом с does.",
            "author": "правило большого пальца",
            "accentColor": "accent2"
          }
        }
