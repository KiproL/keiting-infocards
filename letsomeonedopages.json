            {
              "en": "Let me help you.",
              "ru": "Давай я тебе помогу."
            },
            {
              "en": "My parents let me stay up late.",
              "ru": "Родители разрешали мне не ложиться допоздна."
            },
            {
              "en": "Let him speak.",
              "ru": "Дай ему сказать."
            },
            {
              "en": "They didn't let us in.",
              "ru": "Нас не впустили."
            }
          ]
        },
        {
          "title": "Let не меняется",
          "borderColor": "term",
          "text": "Let — неправильный глагол: let — let — let. Вчера тоже let: My dad let me drive yesterday."
        },
        {
          "title": "«Мне разрешили»",
          "borderColor": "info",
          "text": "Let не бывает в пассиве. «Мне разрешили» — I was allowed to…: She was allowed to leave early."
        }
      ]
    },
