      "sections": [
        {
          "title": "Сигналы",
          "borderColor": "info",
          "rules": [
            {
              "name": "Never / Never before",
              "suffix": "никогда",
              "example": "Never have I felt so happy."
            },
            {
              "name": "Rarely / Seldom",
              "suffix": "редко",
              "example": "Seldom do we see such talent."
            },
            {
              "name": "Not only … but also",
              "suffix": "не только…, но и",
              "example": "Not only is she smart, but she's also kind."
            },
            {
              "name": "Little",
              "suffix": "и не подозревать",
              "example": "Little did he know the truth."
            },
            {
              "name": "Only then / Only when",
              "suffix": "только тогда",
              "example": "Only then did I understand."
            },
            {
              "name": "Not until",
              "suffix": "только когда",
              "example": "Not until he left did I relax."
            },
            {
              "name": "Under no circumstances",
              "suffix": "ни за что",
              "example": "Under no circumstances should you open it."
            },
            {
              "name": "At no time",
              "suffix": "ни разу",
              "example": "At no time was he in danger."
