{
  "tenseName": "Future Simple",
  "route": "cards_futuresimp",
  "slides": [
    {
      "label": "Что это",
      "intro": {
        "text": "Future Simple описывает действие в будущем. Используется для спонтанных решений, обещаний, предложений и предсказаний.",
        "highlights": [
          { "text": "Future Simple",     "color": "term",    "style": "bold_underline" },
          { "text": "в будущем",          "color": "info",    "style": "bold" },
          { "text": "спонтанных решений", "color": "example", "style": "bold" },
          { "text": "предсказаний",        "color": "bad",     "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Формула",
          "borderColor": "term",
          "formulaCard": {
            "parts": [
              { "text": "S",    "color": "info" },
              { "text": "+",    "color": "muted" },
              { "text": "will", "color": "term" },
              { "text": "+",    "color": "muted" },
              { "text": "V",    "color": "example" }
            ],
            "accentColor": "term"
          }
        },
        {
          "title": "Четыре случая употребления",
          "borderColor": "info",
          "table": {
            "headers": ["Случай", "Пример", "Перевод"],
            "headerColors": ["info", "example", "term"],
            "rows": [
              { "cells": ["Спонтанное решение", "I'll have a coffee.",        "Я возьму кофе."] },
              { "cells": ["Обещание",            "I'll call you tomorrow.",   "Я позвоню тебе завтра."] },
              { "cells": ["Предсказание",        "It will rain tomorrow.",     "Завтра будет дождь."] },
              { "cells": ["Предложение помощи",  "I'll help you.",             "Я помогу тебе."] }
            ],
            "borderColor": "info"
          }
        },
        {
          "title": "Ключевые маркеры",
          "borderColor": "good",
          "verbGrid": {
            "accentColor": "example",
            "verbs": ["tomorrow", "next week", "soon", "in a few days", "someday", "in 2030", "tonight", "later"]
          }
        },
        {
          "title": "Живые примеры",
          "borderColor": "good",
          "examples": [
            { "en": "I will call you tomorrow.",        "ru": "Я позвоню тебе завтра." },
            { "en": "She will help us.",                "ru": "Она поможет нам." },
            { "en": "They will arrive soon.",            "ru": "Они скоро приедут." },
            { "en": "I think it will rain tomorrow.",   "ru": "Думаю, завтра будет дождь." }
          ]
        },
        {
          "title": "Мысль напоследок",
          "borderColor": "accent2",
          "quote": {
            "text": "Will — это про решение в моменте, а не про план заранее.",
            "author": "правило большого пальца",
            "accentColor": "accent2"
          }
        }
      ]
    },

    {
      "label": "Три формы",
      "intro": {
        "text": "Will не меняется по лицам. Одна форма для всех — I, you, he, she, it, we, they.",
        "highlights": [
          { "text": "не меняется",  "color": "term",    "style": "bold_underline" },
          { "text": "одна форма",    "color": "info",    "style": "bold" },
          { "text": "для всех",       "color": "example", "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Утверждение",
          "borderColor": "good",
          "formulaCard": {
            "parts": [
              { "text": "I / You / He / She / It / We / They", "color": "info" },
              { "text": "+",                                   "color": "muted" },
              { "text": "will + V",                            "color": "example" }
            ],
            "accentColor": "good"
          },
          "examples": [
            { "en": "I will call you tomorrow.",   "ru": "Я позвоню тебе завтра." },
            { "en": "She will help us.",            "ru": "Она поможет нам." },
            { "en": "They will arrive soon.",        "ru": "Они скоро приедут." }
          ]
        },
        {
          "title": "Отрицание",
          "borderColor": "bad",
          "formulaCard": {
            "parts": [
              { "text": "will", "color": "info" },
              { "text": "+",    "color": "muted" },
              { "text": "not",  "color": "bad" },
              { "text": "+",    "color": "muted" },
              { "text": "V",    "color": "example" }
            ],
            "accentColor": "bad"
          },
          "examples": [
            { "en": "She won't cook dinner tonight.",   "ru": "Она не будет готовить ужин сегодня." },
            { "en": "I won't be late.",                   "ru": "Я не опоздаю." },
            { "en": "They won't come.",                   "ru": "Они не придут." }
          ]
        },
        {
          "title": "Вопрос",
          "borderColor": "info",
          "formulaCard": {
            "parts": [
              { "text": "Will", "color": "info" },
              { "text": "+",    "color": "muted" },
              { "text": "S",    "color": "example" },
              { "text": "+",    "color": "muted" },
              { "text": "V?",   "color": "term" }
            ],
            "accentColor": "info"
          },
          "examples": [
            { "en": "Will they play football?",   "ru": "Они будут играть в футбол?" },
            { "en": "Will you come tomorrow?",     "ru": "Ты придёшь завтра?" },
            { "en": "What will you do next?",       "ru": "Что ты будешь делать дальше?" }
          ]
        },
        {
          "title": "Краткие ответы",
          "borderColor": "term",
          "table": {
            "headers": ["Вопрос", "Да", "Нет"],
            "headerColors": ["info", "good", "bad"],
            "rows": [
              { "cells": ["Will you come?",   "Yes, I will.",     "No, I won't."] },
              { "cells": ["Will she help?",    "Yes, she will.",   "No, she won't."] }
            ],
            "borderColor": "term"
          }
        }
      ]
    },

    {
      "label": "Сокращения",
      "intro": {
        "text": "В устной речи will почти всегда сокращается. Это норма, а не неформальность — даже в новостях и на BBC.",
        "highlights": [
          { "text": "сокращается",  "color": "term",    "style": "bold_underline" },
          { "text": "почти всегда",  "color": "info",    "style": "bold" },
          { "text": "норма",          "color": "example", "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Таблица сокращений",
          "borderColor": "info",
          "table": {
            "headers": ["Полная форма", "Сокращение", "Произношение"],
            "headerColors": ["info", "example", "term"],
            "rows": [
              { "cells": ["I will",         "I'll",       "[aɪl]"] },
              { "cells": ["you will",       "you'll",     "[juːl]"] },
              { "cells": ["he will",         "he'll",      "[hiːl]"] },
              { "cells": ["she will",        "she'll",     "[ʃiːl]"] },
              { "cells": ["it will",         "it'll",      "[ɪtl]"] },
              { "cells": ["we will",         "we'll",      "[wiːl]"] },
              { "cells": ["they will",       "they'll",    "[ðeɪl]"] },
              { "cells": ["will not",        "won't",      "[wəʊnt]"] }
            ],
            "borderColor": "info"
          }
        },
        {
          "title": "Живые примеры",
          "borderColor": "good",
          "examples": [
            { "en": "I'll send you the file.",         "ru": "Я отправлю тебе файл." },
            { "en": "They'll be here at 6.",             "ru": "Они будут здесь в 6." },
            { "en": "We won't forget this.",              "ru": "Мы этого не забудем." },
            { "en": "She'll call you tonight.",           "ru": "Она позвонит тебе вечером." }
          ]
        },
        {
          "title": "Shall — формальный вариант",
          "borderColor": "term",
          "callout": {
            "type": "info",
            "title": "Shall для I и we",
            "text": "В формальной речи с I и we иногда используют shall вместо will: I shall return. В современном английском это редкость, но в литературе встречается."
          }
        }
      ]
    },

    {
      "label": "Слова-маркеры",
      "intro": {
        "text": "Эти слова подсказывают, что речь идёт о будущем действии или предположении.",
        "highlights": [
          { "text": "Слова-маркеры",  "color": "term",    "style": "bold_underline" },
          { "text": "о будущем",       "color": "info",    "style": "bold" },
          { "text": "предположении",   "color": "example", "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Временные маркеры",
          "borderColor": "info",
          "table": {
            "headers": ["Маркер", "Перевод", "Пример"],
            "headerColors": ["info", "example", "term"],
            "rows": [
              { "cells": ["tomorrow",       "завтра",                    "I'll finish it tomorrow."] },
              { "cells": ["next week",       "на следующей неделе",       "We'll meet next week."] },
              { "cells": ["soon",             "скоро",                     "The bus will arrive soon."] },
              { "cells": ["in a few days",    "через несколько дней",     "She'll call in a few days."] },
              { "cells": ["someday",          "когда-нибудь",              "I'll visit Japan someday."] },
              { "cells": ["tonight",          "сегодня вечером",           "I'll call you tonight."] },
              { "cells": ["later",             "позже",                     "I'll do it later."] }
            ],
            "borderColor": "info"
          }
        },
        {
          "title": "Маркеры предположения",
          "borderColor": "term",
          "examples": [
            { "en": "I think it will rain tomorrow.",        "ru": "Думаю, завтра будет дождь." },
            { "en": "I'm sure she will pass the exam.",       "ru": "Уверен, она сдаст экзамен." },
            { "en": "I hope you will come.",                   "ru": "Надеюсь, ты придёшь." },
            { "en": "Probably he will agree.",                  "ru": "Наверное, он согласится." }
          ]
        },
        {
          "title": "Живые примеры",
          "borderColor": "good",
          "examples": [
            { "en": "I'll call you in a few days.",       "ru": "Я позвоню тебе через пару дней." },
            { "en": "I hope you'll come to my party.",    "ru": "Надеюсь, ты придёшь на мою вечеринку." },
            { "en": "I'll visit Japan someday.",           "ru": "Когда-нибудь я побываю в Японии." }
          ]
        }
      ]
    },

    {
      "label": "Will vs Going to",
      "intro": {
        "text": "Will и going to оба говорят о будущем, но используются в разных ситуациях. Их легко перепутать, поэтому запомни главное: will — решение в моменте, going to — план заранее.",
        "highlights": [
          { "text": "Will",      "color": "info",    "style": "bold" },
          { "text": "going to",  "color": "term",    "style": "bold" },
          { "text": "в моменте",  "color": "example", "style": "bold_underline" },
          { "text": "заранее",     "color": "bad",     "style": "bold_underline" }
        ]
      },
      "sections": [
        {
          "title": "Сравнение",
          "borderColor": "info",
          "table": {
            "headers": ["Ситуация", "Will", "Going to"],
            "headerColors": ["info", "example", "term"],
            "rows": [
              { "cells": ["Спонтанное решение", "I'll have coffee.",          "—"] },
              { "cells": ["План заранее",        "—",                         "I'm going to study medicine."] },
              { "cells": ["Обещание",             "I'll help you.",           "—"] },
              { "cells": ["Предсказание",         "I think it will rain.",    "It's going to rain (тучи)."] }
            ],
            "borderColor": "info"
          }
        },
        {
          "title": "Сравнение — план",
          "borderColor": "term",
          "examples": [
            { "en": "I'm going to study medicine.",       "ru": "Я собираюсь изучать медицину. (заранее)" },
            { "en": "Okay, I'll study medicine then.",     "ru": "Хорошо, тогда я буду изучать медицину. (спонтанно)" }
          ]
        },
        {
          "title": "Сравнение — предсказание",
          "borderColor": "info",
          "examples": [
            { "en": "Look at those clouds! It's going to rain.", "ru": "Посмотри на тучи! Будет дождь. (по признакам)" },
            { "en": "I think it will rain next week.",             "ru": "Думаю, на следующей неделе пойдёт дождь. (без доказательств)" }
          ]
        },
        {
          "title": "Как запомнить",
          "borderColor": "good",
          "callout": {
            "type": "tip",
            "title": "Правило большого пальца",
            "text": "Если решение пришло в голову только что — will. Если было решено раньше — going to. Если есть видимые признаки — going to. Если просто мнение — will."
          }
        },
        {
          "title": "Мысль напоследок",
          "borderColor": "accent2",
          "quote": {
            "text": "Will — это реакция. Going to — это намерение.",
            "author": "правило большого пальца",
            "accentColor": "accent2"
          }
        }
      ]
    },

    {
      "label": "Ошибки",
      "intro": {
        "text": "Семь самых частых ошибок в Future Simple — слева как нельзя, справа как правильно.",
        "highlights": [
          { "text": "Семь самых частых", "color": "bad", "style": "bold_underline" }
        ]
      },
      "sections": [
        {
          "title": "Слева — нельзя, справа — правильно",
          "borderColor": "bad",
          "errors": [
            { "wrong": "I will to call you.",         "right": "I will call you." },
            { "wrong": "She wills help us.",            "right": "She will help us." },
            { "wrong": "Do you will come?",             "right": "Will you come?" },
            { "wrong": "I don't will go.",               "right": "I won't go." },
            { "wrong": "I will call you yesterday.",     "right": "I will call you tomorrow." },
            { "wrong": "Will I'll see you?",             "right": "Will I see you?" },
            { "wrong": "I'll can help you.",              "right": "I'll be able to help you." }
          ]
        },
        {
          "title": "Совет",
          "borderColor": "good",
          "callout": {
            "type": "tip",
            "title": "Правило большого пальца",
            "text": "Will — модальный глагол. После него чистый инфинитив без to. И не будет, и won't не сочетаются с другими модальными (can, must). Вместо них — be able to, have to."
          },
          "quote": {
            "text": "Will — простой, но ошибки с ним самые частые.",
            "author": "заметка на полях",
            "accentColor": "accent2"
          }
        }
      ]
    }
  ]
}
