          "callout": {
            "type": "info",
            "title": "Первая d не слышна",
            "text": "Wednesday читается [ˈwenzdeɪ] — «уэнздэй»."
          }
        },
        {
          "title": "Живые примеры",
          "borderColor": "good",
          "examples": [
            {
              "en": "I work from Monday to Friday.",
              "ru": "Я работаю с понедельника по пятницу."
            },
            {
              "en": "See you on Tuesday!",
              "ru": "Увидимся во вторник!"
            },
            {
              "en": "I go swimming on Saturdays.",
              "ru": "По субботам я хожу в бассейн — каждую неделю."
            }
          ]
        },
        {
          "title": "Когда on не нужен",
          "borderColor": "term",
          "text": "Перед next, last, this и every предлог не ставим. О выходных в британском английском говорят at the weekend, в американском — on the weekend.",
          "examples": [
            {
              "en": "See you next Monday.",
              "ru": "Увидимся в следующий понедельник."
            },
            {
              "en": "I saw her last Friday.",
              "ru": "Я видел её в прошлую пятницу."
            },
            {
              "en": "What are you doing at the weekend?",
              "ru": "Что делаешь на выходных?"
            }
          ]
        }
      ]
    },
