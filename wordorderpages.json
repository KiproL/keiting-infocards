{
  "tenseName": "Word Order",
  "route": "cards_wordorder",
  "slides": [
    {
      "label": "Что это",
      "intro": {
        "text": "В русском слова можно переставлять почти как угодно, в английском — нет: порядок держит смысл. «Собака укусила кота» и «Кота укусила собака» — одно и то же, а The dog bit the cat и The cat bit the dog — разные истории.",
        "highlights": [
          {
            "text": "порядок держит смысл",
            "color": "term",
            "style": "bold_underline"
          },
          {
            "text": "The dog bit the cat",
            "color": "example",
            "style": "bold"
          },
          {
            "text": "The cat bit the dog",
            "color": "bad",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Основная схема",
          "borderColor": "term",
          "formulaCard": {
            "parts": [
              {
                "text": "Кто",
                "color": "example"
              },
              {
                "text": "+",
                "color": "muted"
              },
              {
                "text": "делает",
                "color": "term"
              },
              {
                "text": "+",
                "color": "muted"
              },
              {
                "text": "что / кого",
                "color": "info"
              },
              {
                "text": "+",
                "color": "muted"
              },
              {
                "text": "где",
                "color": "muted"
              },
              {
                "text": "+",
                "color": "muted"
              },
              {
                "text": "когда",
                "color": "muted"
              }
            ],
            "accentColor": "term"
          }
        },
        {
          "title": "Разбор",
          "borderColor": "info",
          "table": {
            "headers": [
              "Кто",
              "Делает",
              "Что",
              "Где, когда"
            ],
            "rows": [
