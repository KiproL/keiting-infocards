    {
      "label": "Also, only, enough",
      "intro": {
        "text": "Несколько маленьких слов со своим местом. Also стоит как наречия частоты, а enough — после прилагательного, но перед существительным.",
        "highlights": [
          {
            "text": "Also",
            "color": "info",
            "style": "bold"
          },
          {
            "text": "enough",
            "color": "term",
            "style": "bold_underline"
          },
          {
            "text": "после прилагательного",
            "color": "example",
            "style": "bold"
          },
          {
            "text": "перед существительным",
            "color": "example",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Где стоят",
          "borderColor": "term",
          "rules": [
            {
              "name": "also",
              "suffix": "перед глаголом, после be",
              "example": "I also like jazz. She is also a teacher."
            },
            {
              "name": "too / as well",
              "suffix": "в конце",
              "example": "I like jazz too."
            },
            {
              "name": "only",
              "suffix": "перед тем, что ограничивает",
              "example": "I only drink tea. Only Tom knows."
            },
            {
              "name": "enough + прилагательное",
              "suffix": "после",
              "example": "He isn't old enough."
            },
            {
              "name": "enough + существительное",
              "suffix": "перед",
              "example": "We have enough time."
            },
            {
              "name": "still",
              "suffix": "как also",
              "example": "She still lives here."
            }
          ]
        }
      ]
    },
