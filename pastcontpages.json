    {
      "label": "Как добавить -ing",
      "intro": {
        "text": "Окончание -ing добавляется к глаголу независимо от подлежащего. Написание зависит от последних букв глагола.",
        "highlights": [
          {
            "text": "-ing",
            "color": "term",
            "style": "bold_underline"
          },
          {
            "text": "Написание",
            "color": "info",
            "style": "bold"
          }
        ]
      },
      "sections": [
        {
          "title": "Правила",
          "borderColor": "info",
          "rules": [
            {
              "name": "Большинство",
              "suffix": "+ ing",
              "example": "play → playing, read → reading"
            },
            {
              "name": "Немая -e",
              "suffix": "e убирается + ing",
              "example": "make → making, write → writing"
            },
            {
              "name": "Гласная + согл. в конце",
              "suffix": "удвоение + ing",
              "example": "run → running, sit → sitting"
            },
            {
              "name": "Глаголы на -ie",
              "suffix": "ie → y + ing",
              "example": "lie → lying, die → dying"
            }
          ]
        },
        {
          "title": "Исключение",
          "borderColor": "term",
          "table": {
            "headers": [
              "Глагол",
              "V-ing",
              "Перевод"
            ],
            "headerColors": [
              "info",
              "example",
              "term"
            ],
            "rows": [
              {
                "cells": [
                  "see",
                  "seeing",
                  "видеть"
                ]
              },
              {
                "cells": [
                  "agree",
                  "agreeing",
                  "соглашаться"
                ]
              }
            ],
            "borderColor": "term"
          },
          "callout": {
            "type": "tip",
            "title": "ee не сокращается",
            "text": "Если слово оканчивается на -ee (see, agree), то -e сохраняется: see → seeing, agree → agreeing."
          }
        },
        {
          "title": "Живые примеры",
          "borderColor": "good",
          "examples": [
            {
