            "rules": [
              {
                "name": "to",
                "suffix": "тот же человек",
                "example": "I left early to catch the bus."
              },
              {
                "name": "so that",
                "suffix": "другой человек",
                "example": "I left early so that you could sleep."
              },
              {
                "name": "so … won't",
                "suffix": "чтобы не",
                "example": "Write it down so that you won't forget."
              }
