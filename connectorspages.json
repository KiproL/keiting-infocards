    {
      "label": "Что это",
      "intro": {
        "text": "Связки скрепляют слова и предложения. Предлоги связывают слова между собой, verb patterns определяют, что идёт после глагола, а relative clauses присоединяют придаточные.",
        "highlights": [
          { "text": "Связки",           "color": "term",    "style": "bold_underline" },
          { "text": "скрепляют",         "color": "info",    "style": "bold" },
          { "text": "присоединяют",       "color": "example", "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Три подтемы",
          "borderColor": "info",
          "table": {
            "headers": ["Подтема", "Что связывает", "Пример"],
            "headerColors": ["info", "example", "term"],
            "rows": [
              { "cells": ["Prepositions",     "слова и фразы",   "in the morning, on Monday, at 5"] },
              { "cells": ["Verb patterns",     "глагол + форма",   "want to go, enjoy doing"] },
              { "cells": ["Relative clauses",  "придаточные",      "the man who called"] }
            ],
            "borderColor": "info"
          }
        },
        {
          "title": "Мысль напоследок",
          "borderColor": "accent2",
          "quote": {
            "text": "Связки — то, что делает речь плавной, а не рубленой.",
            "author": "правило большого пальца",
            "accentColor": "accent2"
          }
        }
      ]
    },

    {
      "label": "Prepositions of time",
      "intro": {
        "text": "Три предлога времени — in, on, at. Каждый используется со своим уровнем точности: от широкого периода к конкретной точке.",
        "highlights": [
          { "text": "in, on, at",        "color": "term",    "style": "bold_underline" },
          { "text": "точности",           "color": "info",    "style": "bold" },
          { "text": "от широкого",         "color": "example", "style": "bold" },
          { "text": "к конкретной",        "color": "bad",     "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Логика",
          "borderColor": "term",
          "formulaCard": {
            "parts": [
              { "text": "in", "color": "info" },
              { "text": "→ широкое",   "color": "example" },
              { "text": "·",  "color": "muted" },
              { "text": "on", "color": "term" },
              { "text": "→ точное",     "color": "example" },
              { "text": "·",  "color": "muted" },
              { "text": "at", "color": "bad" },
              { "text": "→ точка",      "color": "example" }
            ],
            "accentColor": "term"
          }
        },
        {
          "title": "Полная таблица",
          "borderColor": "info",
          "table": {
            "headers": ["Предлог", "Когда", "Пример"],
            "headerColors": ["info", "example", "term"],
            "rows": [
              { "cells": ["in",  "месяц, год, время года, часть дня", "in May, in 2024, in summer, in the morning"] },
              { "cells": ["on",  "день недели, дата, конкретный день","on Monday, on 5 May, on my birthday"] },
              { "cells": ["at",  "время, момент, ночь, праздники",     "at 5 o'clock, at noon, at night, at Christmas"] }
            ],
            "borderColor": "info"
          }
        },
        {
          "title": "Исключения",
          "borderColor": "bad",
          "rules": [
            { "name": "at night",         "suffix": "не in the night",     "example": "I work at night." },
            { "name": "at the weekend",    "suffix": "BrE",                  "example": "See you at the weekend." },
            { "name": "on the weekend",    "suffix": "AmE",                  "example": "See you on the weekend." },
            { "name": "at Christmas",      "suffix": "праздник в целом",     "example": "We visit family at Christmas." },
            { "name": "on Christmas Day",  "suffix": "конкретный день",      "example": "We meet on Christmas Day." },
            { "name": "in the morning",    "suffix": "часть дня",            "example": "I run in the morning." }
          ]
        },
        {
          "title": "Живые примеры",
          "borderColor": "good",
          "examples": [
            { "en": "I was born in May.",            "ru": "Я родился в мае." },
            { "en": "We meet on Mondays.",             "ru": "Мы встречаемся по понедельникам." },
            { "en": "The film starts at 8 pm.",         "ru": "Фильм начинается в 8 вечера." },
            { "en": "I work at night.",                  "ru": "Я работаю ночью." }
          ]
        }
      ]
    },

