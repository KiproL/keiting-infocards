    {
      "label": "Relative Clauses",
      "intro": {
        "text": "Относительные придаточные уточняют или описывают существительное. Присоединяются словами who, which, that, whose, where.",
        "highlights": [
          { "text": "Relative Clauses", "color": "term",    "style": "bold_underline" },
          { "text": "уточняют",          "color": "info",    "style": "bold" },
          { "text": "who, which, that",   "color": "example", "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Полная таблица",
          "borderColor": "info",
          "table": {
            "headers": ["Слово", "О ком / о чём", "Пример"],
            "headerColors": ["info", "example", "term"],
            "rows": [
              { "cells": ["who",    "о людях",              "The man who called is my uncle."] },
              { "cells": ["whom",    "о людях (формально)",  "The man whom I met was kind."] },
              { "cells": ["whose",   "о принадлежности",      "The girl whose bag was lost is here."] },
              { "cells": ["which",   "о вещах и животных",    "The book which I read was great."] },
              { "cells": ["that",    "о людях и вещах",        "The film that we saw was boring."] },
              { "cells": ["where",   "о месте",                "The city where I live is big."] }
            ],
            "borderColor": "info"
          }
        },
        {
          "title": "Определяющие vs описательные",
          "borderColor": "term",
          "callout": {
            "type": "info",
            "title": "Запятая меняет смысл",
            "text": "Без запятой — придаточное необходимо для смысла. С запятой — просто дополнительная информация."
          },
          "examples": [
            { "en": "The students who studied passed.",         "ru": "Те студенты, которые учились, сдали. (только они)" },
            { "en": "The students, who studied, passed.",        "ru": "Студенты, которые (все) учились, сдали. (доп. инфо)" }
          ]
        },
        {
          "title": "Когда можно опустить",
          "borderColor": "good",
          "rules": [
            { "name": "who / which в функции объекта", "suffix": "можно опустить", "example": "The book (which) I read was great." },
            { "name": "who / which в функции субъекта","suffix": "нельзя опустить","example": "The man who called is my uncle." },
            { "name": "that в разговоре",                "suffix": "чаще в речи",     "example": "The film that I saw…" }
          ]
        },
        {
          "title": "Живые примеры",
          "borderColor": "good",
          "examples": [
            { "en": "The man who called is my uncle.",         "ru": "Мужчина, который позвонил, — мой дядя." },
            { "en": "The book which I read was great.",          "ru": "Книга, которую я прочитал, отличная." },
            { "en": "The city where I live is big.",              "ru": "Город, где я живу, большой." },
            { "en": "The girl whose bag was lost is here.",       "ru": "Девочка, чья сумка потерялась, здесь." }
          ]
        }
      ]
    },

    {
