    {
      "label": "Verb patterns",
      "intro": {
        "text": "Некоторые глаголы требуют после себя to + инфинитив, другие — -ing. Третьи допускают оба варианта со сменой смысла.",
        "highlights": [
          { "text": "Verb patterns",   "color": "term",    "style": "bold_underline" },
          { "text": "to + инфинитив",   "color": "info",    "style": "bold" },
          { "text": "-ing",             "color": "example", "style": "bold" },
          { "text": "оба варианта",      "color": "bad",     "style": "bold" }
        ]
      },
      "sections": [
        {
          "title": "Три группы",
          "borderColor": "info",
          "table": {
            "headers": ["Группа", "Форма", "Пример"],
            "headerColors": ["info", "example", "term"],
            "rows": [
              { "cells": ["Только to",  "V + to + инфинитив", "want, decide, hope, plan, promise"] },
              { "cells": ["Только -ing","V + -ing",             "enjoy, finish, mind, avoid, suggest"] },
              { "cells": ["Оба",         "смысл меняется",       "stop, remember, forget, try, regret"] }
            ],
            "borderColor": "info"
          }
        },
        {
          "title": "Только to + инфинитив",
          "borderColor": "info",
          "verbGrid": {
            "accentColor": "info",
            "verbs": ["want", "decide", "hope", "plan", "promise", "agree", "refuse", "learn", "manage", "offer", "expect", "afford", "arrange", "fail", "pretend", "seem", "tend"]
          },
          "examples": [
            { "en": "I want to go home.",       "ru": "Я хочу пойти домой." },
            { "en": "She decided to stay.",      "ru": "Она решила остаться." },
            { "en": "They hope to win.",          "ru": "Они надеются победить." }
          ]
        },
        {
          "title": "Только -ing",
          "borderColor": "good",
          "verbGrid": {
            "accentColor": "example",
            "verbs": ["enjoy", "finish", "mind", "avoid", "suggest", "keep", "practise", "consider", "imagine", "miss", "risk", "deny", "admit", "postpone", "give up", "dislike", "fancy", "can't stand"]
          },
          "examples": [
            { "en": "I enjoy reading.",          "ru": "Я люблю читать." },
            { "en": "She finished cooking.",      "ru": "Она закончила готовить." },
            { "en": "Would you mind waiting?",    "ru": "Вы не против подождать?" }
          ]
